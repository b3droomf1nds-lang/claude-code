    {% comment %}
      Custom "Package Protection" toggle, replacing the Navidium shipping-
      protection widget in the AOV cart drawer footer. Adds/removes a real
      "Shipping Protection" line item (product 15638394405190) priced at a
      tier matched to ~2% of the cart subtotal, rounded up and charm-priced
      (e.g. $1.99, $2.99 ... $19.99, floored/capped at those ends). 2% plus
      charm pricing (.99 endings) chosen over the old flat 3.5%/whole-dollar
      model to sit in the industry-typical opt-in-friendly range while
      maximizing fee revenue, since this fee is pure margin (self-funded,
      no reinsurance cut).

      AOV re-renders the drawer wholesale on every cart change, so a
      MutationObserver (debounced for performance) keeps the widget mounted
      in place and its price/state in sync with the cart. The widget mounts
      right after the cart line items (.AOV-CDMinimal__Content) and before
      "You might also like" (.AOV-UpsellProducts-Divider) so it reads as
      part of the order instead of crowding the upsell/subtotal area.

      This same script also maintains a small floating scroll-affordance
      arrow (#voltical-scroll-hint, appended once to <body>, positioned via
      the footer's live bounding rect) that only appears while the drawer
      is open AND has more content below the fold -- paired with the mobile
      density CSS above that trims section padding so less scrolling is
      needed in the first place.
    {% endcomment %}
    <script>
      (function () {
        var PRODUCT_ID = 15638394405190;
        // 19 tiers: $1.99 (index 1) through $19.99 (index 19), matching
        // variant titles "1".."19" on the Shipping Protection product.
        var TIER_VARIANTS = [
          56912465297734, 56912465330502, 56912465363270, 56912465396038, 56912465428806,
          56912465461574, 56912465494342, 56912465527110, 56912465559878, 56912465592646,
          56912465625414, 56912465658182, 56912465690950, 56912465723718, 56912465756486,
          56912465789254, 56912465822022, 56912465854790, 56912465887558
        ];

        var widgetEl = null;
        var debounceTimer = null;
        var busy = false;
        var scrollHintEl = null;
        var boundScrollBody = null;
        // Last cart snapshot we've fetched, cached so debouncedTick can
        // repaint the reward bar synchronously (see below) instead of
        // waiting on a network round trip -- that wait is what let AOV's
        // own (protection-inclusive) reward bar text flash on screen for a
        // moment before our corrected text replaced it.
        var lastCart = null;

        function findAnchor() {
          var body = document.querySelector('.AOV-CDMinimal__Body');
          if (body) {
            for (var i = 0; i < body.children.length; i++) {
              if (body.children[i].classList.contains('AOV-CDMinimal__Content')) {
                return { parent: body, before: body.children[i].nextSibling };
              }
            }
          }
          var footer = document.querySelector('.AOV-CDMinimal__Footer');
          if (footer) {
            return { parent: footer, before: footer.firstChild };
          }
          return null;
        }

        function money(cents) {
          try {
            var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
            return new Intl.NumberFormat(undefined, {
              style: 'currency',
              currency: currency
            }).format(cents / 100);
          } catch (e) {
            return '$' + (cents / 100).toFixed(2);
          }
        }

        // 2% of subtotal, charm-priced: tier N -> $(N + 0.99), N clamped 1-19,
        // so fees run $1.99 (small carts) up to $19.99 (large carts).
        function tierForSubtotal(subtotalCents) {
          var dollars = subtotalCents / 100;
          var n = Math.ceil(dollars * 0.02);
          if (n < 1) n = 1;
          if (n > 19) n = 19;
          return n;
        }

        function tierPriceCents(tier) {
          return tier * 100 + 99;
        }

        function buildWidget() {
          if (widgetEl) return widgetEl;
          var el = document.createElement('div');
          el.id = 'voltical-protection-widget';
          el.className = 'vp-widget';
          el.setAttribute('data-vp-state', 'off');
          el.innerHTML =
            '<div class="vp-icon">' +
              '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                '<path d="M12 2L4 5V11C4 16.55 7.84 21.74 12 23C16.16 21.74 20 16.55 20 11V5L12 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>' +
                '<path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
              '</svg>' +
            '</div>' +
            '<div class="vp-copy">' +
              '<div class="vp-title">Package Protection</div>' +
              '<div class="vp-subtitle">Covers loss, damage &amp; theft in transit</div>' +
            '</div>' +
            '<div class="vp-right">' +
              '<span class="vp-price">' + money(199) + '</span>' +
              '<button type="button" class="vp-toggle" role="switch" aria-checked="false" aria-label="Add package protection">' +
                '<span class="vp-toggle-knob"></span>' +
              '</button>' +
            '</div>';
          el.querySelector('.vp-toggle').addEventListener('click', onToggleClick);
          widgetEl = el;
          return el;
        }

        function setLoading(isLoading) {
          busy = isLoading;
          var btn = widgetEl.querySelector('.vp-toggle');
          btn.disabled = isLoading;
          widgetEl.classList.toggle('vp-loading', isLoading);
        }

        function onToggleClick() {
          if (busy) return;
          var isOn = widgetEl.getAttribute('data-vp-state') === 'on';
          var optimisticState = isOn ? 'off' : 'on';
          widgetEl.setAttribute('data-vp-state', optimisticState);
          var toggleBtn = widgetEl.querySelector('.vp-toggle');
          toggleBtn.setAttribute('aria-checked', optimisticState === 'on' ? 'true' : 'false');
          setLoading(true);
          if (lastCart) patchRewardBar(lastCart);
          (isOn ? removeProtection() : addProtection())
            .catch(function () {})
            .then(function () { return refresh(); })
            .then(function () { setLoading(false); });
        }

        function getCart() {
          return fetch('/cart.js').then(function (r) { return r.json(); });
        }

        function findProtectionLine(cart) {
          for (var i = 0; i < cart.items.length; i++) {
            if (cart.items[i].product_id === PRODUCT_ID) return cart.items[i];
          }
          return null;
        }

        function nonProtectionSubtotal(cart) {
          var total = 0;
          cart.items.forEach(function (item) {
            if (item.product_id !== PRODUCT_ID) total += item.line_price;
          });
          return total;
        }

        function addProtection() {
          return getCart().then(function (cart) {
            var subtotal = nonProtectionSubtotal(cart);
            var tier = tierForSubtotal(subtotal);
            var variantId = TIER_VARIANTS[tier - 1];
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
            });
          });
        }

        function removeProtection() {
          return getCart().then(function (cart) {
            var line = findProtectionLine(cart);
            if (!line) return Promise.resolve();
            return fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: line.key, quantity: 0 })
            });
          });
        }

        function syncVariantToTier(cart) {
          var line = findProtectionLine(cart);
          if (!line) return Promise.resolve();
          var subtotal = nonProtectionSubtotal(cart);
          var tier = tierForSubtotal(subtotal);
          var desiredVariantId = TIER_VARIANTS[tier - 1];
          if (line.variant_id === desiredVariantId) return Promise.resolve();
          return fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: line.key, quantity: 0 })
          }).then(function () {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: desiredVariantId, quantity: 1 }] })
            });
          });
        }

        function render(cart) {
          var line = findProtectionLine(cart);
          var subtotal = nonProtectionSubtotal(cart);
          var tier = tierForSubtotal(subtotal);
          var priceEl = widgetEl.querySelector('.vp-price');
          var subtitleEl = widgetEl.querySelector('.vp-subtitle');
          var btn = widgetEl.querySelector('.vp-toggle');
          var isOn = !!line;
          widgetEl.setAttribute('data-vp-state', isOn ? 'on' : 'off');
          btn.setAttribute('aria-checked', isOn ? 'true' : 'false');
          btn.setAttribute('aria-label', isOn ? 'Remove package protection' : 'Add package protection');
          var desiredPrice = money(tierPriceCents(tier));
          if (priceEl.textContent !== desiredPrice) priceEl.textContent = desiredPrice;
          var desiredSubtitle = isOn
            ? "You're covered — claims paid in full"
            : 'Covers loss, damage & theft in transit';
          if (subtitleEl.textContent !== desiredSubtitle) subtitleEl.textContent = desiredSubtitle;
        }

        function refresh() {
          return getCart().then(function (cart) {
            return syncVariantToTier(cart).then(function () {
              return getCart();
            });
          }).then(function (cart) {
            lastCart = cart;
            if (widgetEl) render(cart);
            patchItemLabels();
            patchRewardBar(cart);
          }).catch(function () {});
        }

        function ensureMounted() {
          var anchor = findAnchor();
          if (!anchor) return;
          var el = buildWidget();
          if (el.isConnected) return;
          anchor.parent.insertBefore(el, anchor.before);
        }

        function buildScrollHint() {
          if (scrollHintEl) return scrollHintEl;
          var el = document.createElement('button');
          el.type = 'button';
          el.id = 'voltical-scroll-hint';
          el.setAttribute('aria-label', 'Scroll for more');
          el.innerHTML =
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
              '<path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>' +
            '</svg>';
          el.addEventListener('click', function () {
            var b = document.querySelector('.AOV-CDMinimal__Body');
            if (b) b.scrollBy({ top: Math.round(b.clientHeight * 0.6), behavior: 'smooth' });
          });
          document.body.appendChild(el);
          scrollHintEl = el;
          return el;
        }

        function ensureScrollListener(body) {
          if (body && body !== boundScrollBody) {
            boundScrollBody = body;
            body.addEventListener('scroll', updateScrollHint, { passive: true });
          }
        }

        function updateScrollHint() {
          var drawer = document.getElementById('AOV-CDMinimal');
          var body = document.querySelector('.AOV-CDMinimal__Body');
          var footer = document.querySelector('.AOV-CDMinimal__Footer');
          var el = buildScrollHint();
          var isOpen = !!(drawer && drawer.className.indexOf('AOV-CDMinimal--open') !== -1);
          if (!isOpen || !body || !footer) {
            el.classList.remove('vp-scrollhint-visible');
            return;
          }
          ensureScrollListener(body);
          var overflow = body.scrollHeight - body.clientHeight;
          var remaining = overflow - body.scrollTop;
          var shouldShow = overflow > 24 && remaining > 16;
          var footerRect = footer.getBoundingClientRect();
          el.style.left = (footerRect.left + footerRect.width / 2) + 'px';
          el.style.bottom = (window.innerHeight - footerRect.top + 8) + 'px';
          el.classList.toggle('vp-scrollhint-visible', shouldShow);
        }

        function patchItemLabels() {
          var items = document.querySelectorAll('.AOV-CDMinimal__Item');
          for (var i = 0; i < items.length; i++) {
            var item = items[i];
            if (item.getAttribute('data-product-id') === String(PRODUCT_ID)) continue;
            var nameEl = item.querySelector('.AOV-CDMinimal__ItemName');
            var optEl = item.querySelector('.AOV-CDMinimal__ItemOptions');
            if (!nameEl || !optEl) continue;
            var optSpan = optEl.querySelector('span');
            if (!optSpan || !optSpan.textContent.replace(/\s+/g, '')) continue;
            nameEl.classList.add('vp-name-hidden');
            optEl.classList.add('vp-options-enlarged');
          }
        }

        var SHIPPING_GOAL_KEY = 'voltical_shipping_goal_v1';

        var SHIPPING_GOAL_OVERRIDES = {
          'USD': 60,
          'EUR': 55,
          'GBP': 45,
          'CHF': 50,
          'CAD': 90,
          'AUD': 90,
          'NZD': 110,
          'CZK': 1270,
          'DKK': 395,
          'NOK': 590,
          'SEK': 580,
          'PLN': 225,
          'INR': 5720,
          'MXN': 1050,
          'IDR': 1080000
        };

        function getStoredGoal(currency) {
          try {
            var raw = sessionStorage.getItem(SHIPPING_GOAL_KEY);
            if (!raw) return null;
            var data = JSON.parse(raw);
            return data && data.currency === currency ? data.goal : null;
          } catch (e) {
            return null;
          }
        }

        function setStoredGoal(currency, goal) {
          try {
            sessionStorage.setItem(SHIPPING_GOAL_KEY, JSON.stringify({ currency: currency, goal: goal }));
          } catch (e) {}
        }

        function patchRewardBar(cart) {
          var container = document.querySelector('.AOV-CartDrawer-RewardBar__Container');
          if (!container) return;
          var titleEl = container.querySelector('.AOV-CartDrawer-RewardBar__Title');
          var fillEl = container.querySelector('.AOV-CartDrawer-RewardBar__ProgressBar__ProgressFill');
          if (!titleEl || !fillEl) return;

          var currency = cart.currency || (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
          var correctSubtotal = nonProtectionSubtotal(cart) / 100;
          var appTotal = cart.total_price / 100;
          var hasProtection = !!findProtectionLine(cart);
          var goal = SHIPPING_GOAL_OVERRIDES.hasOwnProperty(currency) ?
            SHIPPING_GOAL_OVERRIDES[currency] : getStoredGoal(currency);

          if (!SHIPPING_GOAL_OVERRIDES.hasOwnProperty(currency) && !hasProtection) {
            var amountEl = container.querySelector('.reward-bar-amount');
            var rawRemaining = amountEl ? parseFloat(amountEl.getAttribute('data-original-price')) : NaN;
            if (!isNaN(rawRemaining) && rawRemaining > 0) {
              goal = appTotal + rawRemaining;
              setStoredGoal(currency, goal);
            } else if (!goal) {
              var m = fillEl.style.width.match(/([\d.]+)%\s*-/);
              var pct = m ? parseFloat(m[1]) : (appTotal > 0 ? 100 : 0);
              if (pct > 0 && pct < 100 && appTotal > 0) {
                goal = appTotal / (pct / 100);
                setStoredGoal(currency, goal);
              }
            }
          }

          if (!goal) return;

          var correctRemaining = goal - correctSubtotal;
          var correctPercent = Math.max(0, Math.min(100, (correctSubtotal / goal) * 100));

          if (correctRemaining > 0.004) {
            var desiredHtml = 'You are <span class="notranslate reward-bar-amount" data-original-price="' +
              correctRemaining + '">' + money(Math.round(correctRemaining * 100)) +
              '</span> away from getting Free shipping';
            if (titleEl.innerHTML !== desiredHtml) titleEl.innerHTML = desiredHtml;
          } else {
            var desiredText = 'Congratulations you have unlocked free shipping';
            if (titleEl.textContent !== desiredText) titleEl.textContent = desiredText;
          }
          var desiredWidth = 'clamp(0%, ' + correctPercent + '% - 9px, 100%)';
          if (fillEl.style.width !== desiredWidth) fillEl.style.width = desiredWidth;
        }

        var CABLE_PRODUCT_ID = '15635042140486';
        var CABLE_2M_VARIANT_ID = '56882261229894';
        var patchedUpsellSelects = {};
        function patchUpsellDefaults() {
          var sel = document.getElementById('AOV-MinimalUpsellProducts__ProductVariants__' + CABLE_PRODUCT_ID);
          if (!sel) return;
          var already = patchedUpsellSelects[CABLE_PRODUCT_ID] === sel;
          var target2m = null;
          for (var i = 0; i < sel.options.length; i++) {
            var opt = sel.options[i];
            if ((opt.value || '').indexOf(CABLE_2M_VARIANT_ID) !== -1) { target2m = opt; break; }
          }
          if (!target2m) return;
          if (already && sel.value === target2m.value) return;
          sel.value = target2m.value;
          patchedUpsellSelects[CABLE_PRODUCT_ID] = sel;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function tick() {
          ensureMounted();
          if (widgetEl && !busy) refresh();
          patchItemLabels();
          getCart().then(function (cart) {
            lastCart = cart;
            patchRewardBar(cart);
          }).catch(function () {});
          updateScrollHint();
          patchUpsellDefaults();
        }

        function debouncedTick() {
          ensureMounted();
          patchUpsellDefaults();
          if (lastCart) patchRewardBar(lastCart);
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(tick, 200);
        }

        tick();
        var observer = new MutationObserver(debouncedTick);
        observer.observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>

    <script>
      window.voltical_gallery_zoom = {
        enabled: {{ settings.custom_magnify_enable | json }},
        scale: {{ settings.custom_magnify_strength | json }}
      };
      window.voltical_gallery_nav = {
        hoverNav: {{ settings.custom_hover_nav_enable | json }},
        dots: {{ settings.custom_dots_enable | json }}
      };
    </script>

    <script>
      (function () {
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

        var DEFAULT_SCALE = 2.2;
        var activeImg = null;

        function zoomSettings() {
          return window.voltical_gallery_zoom || { enabled: true, scale: DEFAULT_SCALE };
        }

        function findZoomableImage(target) {
          if (!target || !target.closest) return null;
          if (zoomSettings().enabled === false) return null;
          if ((window.voltical_gallery_nav || {}).hoverNav) return null;
          var wrapper = target.closest('[id^="Slider-Gallery-"] .product__media');
          return wrapper ? wrapper.querySelector('img') : null;
        }

        function resetZoom() {
          if (!activeImg) return;
          activeImg.style.transition = 'transform 0.2s ease';
          activeImg.style.transform = '';
          activeImg.style.transformOrigin = '';
          activeImg = null;
        }

        function onMove(e) {
          var img = findZoomableImage(e.target);
          if (!img) {
            resetZoom();
            return;
          }
          if (img !== activeImg) {
            resetZoom();
            activeImg = img;
            img.style.transition = 'none';
          }
          var rect = img.parentElement.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          var scale = zoomSettings().scale || DEFAULT_SCALE;
          var px = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
          var py = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));
          img.style.transformOrigin = px + '% ' + py + '%';
          img.style.transform = 'scale(' + scale + ')';
        }

        document.addEventListener('mousemove', onMove);
        window.addEventListener('mouseout', function (e) {
          if (!e.relatedTarget) resetZoom();
        });
      })();
    </script>

    <script>
      (function () {
        function navSettings() {
          return window.voltical_gallery_nav || { hoverNav: false, dots: false };
        }

        function galleries() {
          return Array.from(document.querySelectorAll('media-gallery'));
        }

        function getSlides(mg) {
          return Array.from(mg.querySelectorAll('.slider__slide[data-media-id]'));
        }

        function activeIndex(slides) {
          return slides.findIndex(function (s) {
            return s.classList.contains('is-active');
          });
        }

        function initHoverNav(mg) {
          if (mg._volticalHoverNavInit) return;
          if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
          var mediaWrap = mg.querySelector('[id^="Slider-Gallery-"]');
          if (!mediaWrap) return;
          mg._volticalHoverNavInit = true;
          var lastIndex = -1;
          mediaWrap.addEventListener('mousemove', function (e) {
            if (!navSettings().hoverNav) return;
            var slides = getSlides(mg);
            if (!slides.length) return;
            var rect = mediaWrap.getBoundingClientRect();
            if (!rect.width) return;
            var frac = Math.max(0, Math.min(0.999, (e.clientX - rect.left) / rect.width));
            var idx = Math.floor(frac * slides.length);
            if (idx === lastIndex) return;
            lastIndex = idx;
            var target = slides[idx];
            if (target && !target.classList.contains('is-active')) {
              mg.setActiveMedia(target.dataset.mediaId, false);
            }
          });
          mediaWrap.addEventListener('mouseleave', function () {
            lastIndex = -1;
          });
        }

        function initDots(mg) {
          if (mg._volticalDotsInit || !navSettings().dots) return;
          var slides = getSlides(mg);
          if (slides.length < 2) return;
          var viewer = mg.querySelector('[id^="Slider-Gallery-"]');
          if (!viewer) return;
          var mount = viewer.closest('slider-component') || viewer.parentElement;

          var dotsWrap = document.createElement('div');
          dotsWrap.className = 'voltical-custom-dots';
          dotsWrap.setAttribute(
            'style',
            'display:flex;justify-content:center;flex-wrap:wrap;gap:6px;margin-top:10px;'
          );

          var dotEls = slides.map(function (slide, i) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.setAttribute('aria-label', 'Show image ' + (i + 1));
            dot.setAttribute(
              'style',
              'width:7px;height:7px;padding:0;border:none;border-radius:50%;' +
                'background:rgba(0,0,0,0.25);cursor:pointer;transition:background .15s ease;'
            );
            dot.addEventListener('click', function () {
              mg.setActiveMedia(slide.dataset.mediaId, false);
            });
            dotsWrap.appendChild(dot);
            return dot;
          });

          function refresh() {
            var idx = activeIndex(slides);
            dotEls.forEach(function (d, i) {
              d.style.background = i === idx ? 'rgba(0,0,0,0.85)' : 'rgba(0,0,0,0.25)';
            });
          }

          var mo = new MutationObserver(refresh);
          slides.forEach(function (s) {
            mo.observe(s, { attributes: true, attributeFilter: ['class'] });
          });
          refresh();

          mg._volticalDotsInit = true;
          mount.insertAdjacentElement('afterend', dotsWrap);
        }

        function initAll() {
          var settings = navSettings();
          if (!settings.hoverNav && !settings.dots) return;
          galleries().forEach(function (mg) {
            if (settings.hoverNav) initHoverNav(mg);
            if (settings.dots) initDots(mg);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAll);
        } else {
          initAll();
        }
        document.addEventListener('shopify:section:load', initAll);
      })();
    </script>

    <script>
      (function () {
        function ratingFromStars(item) {
          var star = item.querySelector('.jm-star-rating');
          var label = star ? star.getAttribute('aria-label') || '' : '';
          var m = label.match(/([\d.]+)\s+out of/);
          return m ? parseFloat(m[1]) : 0;
        }

        var VOLTICAL_HIDDEN_REVIEW_PHRASES = [
          'three times thicker'
        ];

        function isPermanentlyHidden(item) {
          var text = (item.textContent || '').toLowerCase();
          return VOLTICAL_HIDDEN_REVIEW_PHRASES.some(function (phrase) {
            return text.indexOf(phrase.toLowerCase()) !== -1;
          });
        }

        function enhance(widget) {
          var list = widget.querySelector('.jdgm-review-list');
          if (!list || !list.children.length) return;
          if (widget._volticalLastCount === list.children.length) return;
          widget._volticalLastCount = list.children.length;

          var headerBody = widget.querySelector('.jm-review-widget__header-and-body');
          if (headerBody && !widget.querySelector('.voltical-reviews-heading')) {
            var heading = document.createElement('div');
            heading.className = 'voltical-reviews-heading';
            heading.textContent = 'What Customers Are Saying';
            headerBody.parentElement.insertBefore(heading, headerBody);
          }

          Array.from(list.children).forEach(function (item) {
            if (isPermanentlyHidden(item)) {
              item.classList.add('voltical-review-hidden');
              item.setAttribute('data-voltical-blocked', 'true');
            }
          });

          var items = Array.from(list.children).filter(function (item) {
            return !item.hasAttribute('data-voltical-blocked');
          });
          items.forEach(function (item) {
            item._volticalRating = ratingFromStars(item);
          });
          items.sort(function (a, b) {
            return b._volticalRating - a._volticalRating;
          });
          items.forEach(function (item) {
            list.appendChild(item);
          });

          var existingBtn = widget.querySelector('.voltical-see-more-reviews');
          var revealed = existingBtn ? existingBtn._volticalRevealed : false;

          items.forEach(function (item, i) {
            item.classList.toggle('voltical-review-hidden', !revealed && i >= 3);
          });

          if (items.length > 3 && !existingBtn) {
            var moreBtn = document.createElement('button');
            moreBtn.type = 'button';
            moreBtn.className = 'voltical-see-more-reviews';
            moreBtn.textContent = 'See more reviews';
            moreBtn.addEventListener('click', function () {
              moreBtn._volticalRevealed = true;
              items.forEach(function (item) {
                item.classList.remove('voltical-review-hidden');
              });
              moreBtn.remove();
            });
            list.parentElement.insertAdjacentElement('afterend', moreBtn);
          } else if (items.length <= 3 && existingBtn) {
            existingBtn.remove();
          }
        }

        function scan() {
          document.querySelectorAll('.jdgm-widget-revamp, .jdgm-review-widget').forEach(function (widget) {
            enhance(widget);
          });
        }

        var observer = new MutationObserver(scan);
        observer.observe(document.body, { childList: true, subtree: true });
        scan();
        document.addEventListener('shopify:section:load', function () {
          document.querySelectorAll('.jdgm-widget-revamp, .jdgm-review-widget').forEach(function (widget) {
            widget._volticalLastCount = null;
          });
          scan();
        });
      })();
    </script>
    <script>
      (function () {
        function parseTags(altText) {
          var s = (altText || '').trim();
          var tags = {};
          var colorMatch = s.match(/vcolor:(.*?)(?:\s+vsize:|$)/);
          if (colorMatch) tags.vcolor = colorMatch[1].trim();
          var sizeMatch = s.match(/vsize:(\S+)/);
          if (sizeMatch) tags.vsize = sizeMatch[1].trim().toLowerCase();
          return tags;
        }

        function getSelectedOptions() {
          var result = {};
          document.querySelectorAll('main input[type="radio"]:checked').forEach(function (r) {
            var optName = (r.name || '').replace(/-\d+\s*$/, '').trim();
            if (optName) result[optName] = r.value;
          });
          document.querySelectorAll('main select').forEach(function (s) {
            var optName = (s.name || '').replace(/-\d+\s*$/, '').trim();
            if (optName && s.value) result[optName] = s.value;
          });
          return result;
        }

        function applyGalleryFilter(mg) {
          var viewer = mg.querySelector('[id^="Slider-Gallery-"]');
          if (!viewer) return;
          var slides = Array.prototype.slice.call(viewer.querySelectorAll(':scope > .slider__slide[data-media-id]'));
          if (!slides.length) return;

          var meta = {};
          slides.forEach(function (slide) {
            var img = slide.querySelector('img');
            var tags = parseTags(img ? img.getAttribute('alt') : '');
            meta[slide.dataset.mediaId] = {
              color: tags.vcolor,
              isLifestyle: tags.vcolor === 'lifestyle',
              isUltra: tags.vsize === 'ultra'
            };
          });

          var anyTagged = slides.some(function (s) { return !!meta[s.dataset.mediaId].color; });
          if (!anyTagged) return;

          var opts = getSelectedOptions();
          var color = opts.Color;
          if (!color) return;
          var isUltraSelected = /ultra/i.test(opts.Size || '');

          var visible = slides.filter(function (s) {
            var m = meta[s.dataset.mediaId];
            return m.isLifestyle || m.color === color;
          });
          var ultraGroup = visible.filter(function (s) { return meta[s.dataset.mediaId].isUltra && !meta[s.dataset.mediaId].isLifestyle; });
          var normalGroup = visible.filter(function (s) { return !meta[s.dataset.mediaId].isUltra && !meta[s.dataset.mediaId].isLifestyle; });
          var lifestyleGroup = visible.filter(function (s) { return meta[s.dataset.mediaId].isLifestyle; });

          var ordered = isUltraSelected
            ? ultraGroup.concat(normalGroup).concat(lifestyleGroup)
            : normalGroup.concat(ultraGroup).concat(lifestyleGroup);

          var orderIndex = {};
          ordered.forEach(function (s, i) { orderIndex[s.dataset.mediaId] = i; });
          var visibleIds = {};
          visible.forEach(function (s) { visibleIds[s.dataset.mediaId] = true; });

          var thumbList = mg.querySelector('[id^="Slider-Thumbnails-"]');
          var thumbs = thumbList ? Array.prototype.slice.call(thumbList.querySelectorAll(':scope > [data-target]')) : [];

          slides.forEach(function (slide) {
            var id = slide.dataset.mediaId;
            var hidden = !visibleIds[id];
            slide.classList.toggle('vp-gallery-hidden', hidden);
            slide.style.order = hidden ? 9999 : orderIndex[id];
          });
          thumbs.forEach(function (thumb) {
            var id = thumb.getAttribute('data-target');
            var hidden = !visibleIds[id];
            thumb.classList.toggle('vp-gallery-hidden', hidden);
            thumb.style.order = hidden ? 9999 : (orderIndex[id] === undefined ? 9999 : orderIndex[id]);
          });

          if (ordered.length && mg.setActiveMedia) {
            mg.setActiveMedia(ordered[0].dataset.mediaId, false);
          }
        }

        function initAll() {
          document.querySelectorAll('media-gallery').forEach(applyGalleryFilter);
        }

        document.addEventListener('change', function (e) {
          if (!e.target) return;
          if (e.target.matches('input[type="radio"]') || e.target.matches('select')) {
            if (e.target.closest('main')) setTimeout(initAll, 0);
          }
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAll);
        } else {
          initAll();
        }
        document.addEventListener('shopify:section:load', initAll);
      })();
    </script>
  </body>
</html>