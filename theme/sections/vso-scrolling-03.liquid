{% schema %}
{
  "name": "VSO - Scrolling 03",
  "tag": "section",
  "class": "section vso-node vso-node--v2 vso-scrolling-03",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_advanced_settings",
      "label": "Enable advanced settings",
      "default": false,
      "info": "Shows additional settings for spacing, layout, and typography."
    },
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "Full width",
      "default": true,
      "info": "Make the section content full width (advanced)",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Content max width",
      "min": 40,
      "max": 200,
      "step": 2,
      "unit": "rem",
      "default": 120,
      "visible_if": "{{ section.settings.enable_advanced_settings == true and section.settings.section_full_width == false }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Desktop side spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Adds spacing on the left and right sides of this section on desktop.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Mobile side spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Adds spacing on the left and right sides of this section on mobile.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "select",
      "id": "section_bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background",
      "default": "#F9F9F9"
    },
    {
      "type": "color_background",
      "id": "section_bg_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(90deg, #111827 0%, #000000 100%)",
      "visible_if": "{{ section.settings.section_bg_type == 'gradient' }}"
    },
    {
      "type": "checkbox",
      "id": "bg_full_width",
      "label": "Full width on desktop",
      "default": false,
      "info": "Make section background full width on desktop."
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.bg_full_width == false }}"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Default text color",
      "default": "#1F2937"
    },
    {
      "type": "header",
      "content": "Section Border",
      "visible_if": "{{ section.settings.bg_full_width == false and section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "container_border_width",
      "label": "Border width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.bg_full_width == false and section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "select",
      "id": "container_border_type",
      "label": "Container border type",
      "options": [
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.bg_full_width == false and section.settings.enable_advanced_settings == true and section.settings.container_border_width > 0 }}"
    },
    {
      "type": "color",
      "id": "container_border_color",
      "label": "Container border color",
      "default": "#E5E7EB",
      "visible_if": "{{ section.settings.bg_full_width == false and section.settings.enable_advanced_settings == true and section.settings.container_border_width > 0 and section.settings.container_border_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "container_border_gradient",
      "label": "Container border gradient",
      "info": "Create gradient or solid colors for the container border",
      "default": "linear-gradient(45deg, #E5E7EB 0%, #9CA3AF 100%)",
