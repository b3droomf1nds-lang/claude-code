      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Desktop margin top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Desktop margin bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Mobile margin top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Mobile margin bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "side-by-side",
          "label": "Side-by-side"
        }
      ],
      "default": "side-by-side"
    },
    {
      "type": "range",
      "id": "scrolling_area_width",
      "label": "Scrolling area width",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60,
      "info": "Percentage of space for scrolling blocks when using side-by-side layout",
      "visible_if": "{{ section.settings.desktop_layout == 'side-by-side' }}"
    },
    {
      "type": "range",
      "id": "desktop_layout_gap",
      "label": "Desktop layout gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24,
      "info": "Space between header text and scrolling blocks in side-by-side layout",
      "visible_if": "{{ section.settings.desktop_layout == 'side-by-side' }}"
    },
    {
      "type": "header",
      "content": "Scrolling"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause scrolling on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_edge_fade",
      "label": "Enable edge fading",
      "default": true,
      "info": "Shows a subtle fade on the left and right edges of the scrolling area"
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Gap between blocks",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between image and text",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Header"
