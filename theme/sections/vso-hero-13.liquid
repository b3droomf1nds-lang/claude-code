                    assign title_parts = block.settings.heading | split: '_'
                    assign processed_title = ''
                    assign is_highlighted = false
                    for part in title_parts
                      if is_highlighted
                        capture highlighted_part
                          echo '<span class="vso-hero-13__heading-highlight-' | append: block.id | append: '">' | append: part | append: '</span>'
                        endcapture
                        assign processed_title = processed_title | append: highlighted_part
