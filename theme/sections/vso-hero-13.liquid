<script>
  (() => {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const links = sectionEl.querySelectorAll('[data-vso-scroll-to-buy-buttons="true"]');
    if (!links.length) return;

    const findTarget = () => {
      const selectors = [
        '.product-form__buttons',
        '.product-form-buttons',
        '.ProductForm__BuyButtons',
        '.buy-buttons-block',
        '.shopify-payment-button',
        '[data-product-form]',
        'product-form form',
        'form[action$="/cart/add"]',
        'form[action*="/cart/add"]',
        'form.product-form'
      ];

      const candidates = selectors
        .flatMap((selector) => Array.from(document.querySelectorAll(selector)))
        .filter((el) => el && typeof el.getBoundingClientRect === 'function');

      if (!candidates.length) return null;

      const sectionTop = sectionEl.getBoundingClientRect().top + window.scrollY;
      const positioned = candidates.map((el) => ({ el, top: el.getBoundingClientRect().top + window.scrollY }));

      const above = positioned.filter((c) => c.top < sectionTop).sort((a, b) => b.top - a.top);
      if (above.length) return above[0].el;

      positioned.sort((a, b) => a.top - b.top);
      return positioned[0].el;
    };

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = findTarget();
        if (!target) return;
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VSO - Hero 13",
  "tag": "section",
  "class": "section vso-hero-13",
  "settings": [
    { "type": "header", "content": "Section Settings" },
    {
      "type": "checkbox",
      "id": "enable_advanced_settings",
      "label": "Enable advanced settings",
      "default": false,
      "info": "Shows additional settings for spacing, layout, and typography."
    },
    { "type": "range", "id": "section_max_width", "label": "Content max width", "min": 30, "max": 200, "step": 2, "unit": "rem", "default": 120, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "section_min_height", "label": "Desktop min height", "min": 400, "max": 800, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "section_min_height_mobile", "label": "Mobile min height", "min": 300, "max": 600, "step": 20, "unit": "px", "default": 500 },
    { "type": "range", "id": "padding_horizontal", "label": "Desktop side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "padding_horizontal_mobile", "label": "Mobile side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },

    { "type": "header", "content": "Section Background" },
    {
      "type": "select",
      "id": "section_bg_type",
      "label": "Section background type",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid",
      "info": "Background type for the section"
    },
    { "type": "color", "id": "section_bg_color", "label": "Section background color", "default": "#0F172A", "visible_if": "{{ section.settings.section_bg_type == 'solid' }}", "info": "Background color for the section" },
    { "type": "color_background", "id": "section_bg_gradient", "label": "Section background gradient", "default": "linear-gradient(180deg, #0F172A 0%, #0B1220 100%)", "visible_if": "{{ section.settings.section_bg_type == 'gradient' }}", "info": "Background gradient for the section" },
    { "type": "checkbox", "id": "full_width_desktop", "label": "Full width on desktop", "default": false, "info": "Make section background full width on desktop" },
    { "type": "checkbox", "id": "full_width_mobile", "label": "Full width on mobile", "default": false, "info": "Make section background full width on mobile" },
    { "type": "range", "id": "section_radius", "label": "Desktop border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_radius_mobile", "label": "Mobile border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "section_text_color", "label": "Default text color", "default": "#FFFFFF" },

    { "type": "header", "content": "Content" },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 300, "max": 800, "step": 20, "unit": "px", "default": 600 },

    { "type": "header", "content": "Layout Settings", "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "desktop_grid_gap", "label": "Gap between columns", "min": 20, "max": 80, "step": 4, "unit": "px", "default": 40, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "polaroid_column_gap", "label": "Gap between polaroids in column", "min": 16, "max": 60, "step": 4, "unit": "px", "default": 32, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },

    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top", "label": "Desktop margin top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Desktop margin bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top_mobile", "label": "Mobile margin top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Mobile margin bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Polaroid Images" },
    { "type": "image_picker", "id": "polaroid_1_image", "label": "Polaroid 1 image (left column top)" },
    { "type": "range", "id": "polaroid_1_rotation", "label": "Polaroid 1 rotation", "min": -30, "max": 30, "step": 1, "unit": "deg", "default": -20 },

    { "type": "image_picker", "id": "polaroid_2_image", "label": "Polaroid 2 image (left column bottom)" },
    { "type": "range", "id": "polaroid_2_rotation", "label": "Polaroid 2 rotation", "min": -30, "max": 30, "step": 1, "unit": "deg", "default": 15 },

    { "type": "image_picker", "id": "polaroid_3_image", "label": "Polaroid 3 image (right column top)" },
    { "type": "range", "id": "polaroid_3_rotation", "label": "Polaroid 3 rotation", "min": -30, "max": 30, "step": 1, "unit": "deg", "default": 25 },

    { "type": "image_picker", "id": "polaroid_4_image", "label": "Polaroid 4 image (right column bottom)" },
