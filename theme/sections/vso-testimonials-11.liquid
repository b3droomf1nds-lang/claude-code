<style>
#shopify-section-{{ section.id }} {
  width: 100%;
  max-width: 100%;
  position: relative;
  margin-top: {{ section.settings.margin_top_mobile }}px;
  margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
  padding-left: 0;
  padding-right: 0;
  overflow-x: clip;
  overflow-y: visible;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} {
    overflow-x: clip;
    overflow-y: visible;
    {% if section.settings.section_bg_type == 'gradient' %}
      background: {{ section.settings.section_bg_gradient }};
    {% else %}
      background-color: {{ section.settings.section_bg_color }};
    {% endif %}
  }
}

@media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    {% if section.settings.full_width_desktop %}
      {% if section.settings.section_bg_type == 'gradient' %}
        background: {{ section.settings.section_bg_gradient }};
      {% else %}
        background-color: {{ section.settings.section_bg_color }};
      {% endif %}
    {% endif %}
  }
}

#shopify-section-{{ section.id }}::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 100vw;
  height: 100%;
  transform: translateX(-50%);
  background: {% if section.settings.section_bg_type == 'solid' %}{{ section.settings.section_bg_color }}{% else %}{{ section.settings.section_bg_gradient }}{% endif %};
  z-index: -1;
}

{% unless section.settings.full_width_desktop %}
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}::before { display: none; }

    #shopify-section-{{ section.id }} .section-{{ section.id }} {
      {% if section.settings.section_bg_type == 'gradient' %}
        background: {{ section.settings.section_bg_gradient }};
      {% else %}
        background-color: {{ section.settings.section_bg_color }};
      {% endif %}
      border-radius: {{ section.settings.section_border_radius }}px;
      {% if section.settings.enable_advanced_settings %}
        padding-left: {{ section.settings.padding_horizontal_desktop }}px;
        padding-right: {{ section.settings.padding_horizontal_desktop }}px;
      {% else %}
        padding-left: 40px;
        padding-right: 40px;
      {% endif %}
    }
  }
{% endunless %}
</style>

