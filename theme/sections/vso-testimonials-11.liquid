{% endcomment %}

{%- liquid
  assign rating_block = section.blocks | where: 'type', 'header_rating' | first
  assign title_block = section.blocks | where: 'type', 'header_title' | first
  assign description_block = section.blocks | where: 'type', 'header_description' | first
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial_card'

  assign text_alignment = 'left'
  assign blocks_alignment_desktop = section.settings.card_content_alignment_desktop
  assign blocks_alignment_mobile = section.settings.card_content_alignment_mobile
  
  if blocks_alignment_desktop == 'left'
    assign blocks_justify_desktop = 'flex-start'
  elsif blocks_alignment_desktop == 'center'
    assign blocks_justify_desktop = 'center'
  elsif blocks_alignment_desktop == 'right'
    assign blocks_justify_desktop = 'flex-end'
  endif
  
  if blocks_alignment_mobile == 'left'
    assign blocks_justify_mobile = 'flex-start'
  elsif blocks_alignment_mobile == 'center'
    assign blocks_justify_mobile = 'center'
  elsif blocks_alignment_mobile == 'right'
    assign blocks_justify_mobile = 'flex-end'
  endif
  assign desktop_blocks_gap = section.settings.desktop_blocks_gap
  assign mobile_blocks_gap = section.settings.mobile_blocks_gap
  assign block_padding = section.settings.block_padding
  assign header_blocks_gap = section.settings.header_blocks_gap
  assign stars_title_gap = section.settings.stars_title_gap
  assign content_width = section.settings.content_width

  assign rating_header_text = 'Rated <strong>4.8</strong>/5 based on 140,000+ Total Reviews'
  assign custom_rating_header_font = false
  assign rating_header_as = 'p'
  assign rating_text_color = '#111111'
  assign rating_text_size = 16
  assign header_star_rating = 5
  assign rating_star_color = '#FFFFFF'
  assign rating_star_background_color = '#05B67C'
  assign rating_star_empty_background_color = '#DFDFDF'
  assign rating_star_size = 24
  assign rating_badge_bg_enable = true
  assign rating_bg_color = '#FFFFFF'
  assign rating_padding_horizontal = 14
  assign rating_padding_vertical = 10
  assign rating_shadow_enable = true
  assign rating_border_radius = 100
  assign rating_bottom_spacing = 12
  assign rating_margin_top_desktop = 0
  assign rating_margin_top_mobile = 0
  assign rating_margin_bottom_mobile = 12

  if rating_block != blank
    assign rating_header_text = rating_block.settings.rating_header | default: rating_header_text
    assign custom_rating_header_font = rating_block.settings.custom_rating_header_font | default: false
    assign rating_header_as = rating_block.settings.rating_header_as | default: rating_header_as
    assign rating_text_color = rating_block.settings.rating_text_color | default: rating_text_color
    assign rating_text_size = rating_block.settings.rating_text_size | default: rating_text_size
    assign header_star_rating = rating_block.settings.header_star_rating | default: header_star_rating
    assign rating_star_color = rating_block.settings.rating_star_color | default: rating_star_color
    assign rating_star_background_color = rating_block.settings.rating_star_background_color | default: rating_star_background_color
    assign rating_star_empty_background_color = rating_block.settings.rating_star_empty_background_color | default: rating_star_empty_background_color
    assign rating_star_size = rating_block.settings.rating_star_size | default: rating_star_size
    assign rating_badge_bg_enable = rating_block.settings.rating_badge_bg_enable | default: rating_badge_bg_enable
    assign rating_bg_color = rating_block.settings.rating_bg_color | default: rating_bg_color
    assign rating_padding_horizontal = rating_block.settings.rating_padding_horizontal | default: rating_padding_horizontal
    assign rating_padding_vertical = rating_block.settings.rating_padding_vertical | default: rating_padding_vertical
    assign rating_shadow_enable = rating_block.settings.rating_shadow_enable | default: rating_shadow_enable
    assign rating_border_radius = rating_block.settings.rating_border_radius | default: rating_border_radius
    assign rating_bottom_spacing = rating_block.settings.rating_bottom_spacing | default: rating_bottom_spacing
    assign rating_margin_top_desktop = rating_block.settings.rating_margin_top_desktop | default: rating_margin_top_desktop
    assign rating_margin_top_mobile = rating_block.settings.rating_margin_top_mobile | default: rating_margin_top_mobile
    assign rating_margin_bottom_mobile = rating_block.settings.rating_margin_bottom_mobile | default: rating_margin_bottom_mobile
  endif

  assign title_text = 'Their Waists. <em>Their Words.</em>'
  assign title_highlight_color = 'linear-gradient(135deg, #FFB4A9 0%, #FF7A6E 100%)'
  assign title_highlight_enable_custom = false
  assign title_highlight_font = blank
  assign title_highlight_font_weight = 700
  assign custom_title_font = false
  assign title_as = 'h2'
  assign title_size_desktop = 40
  assign title_size_mobile = 32
  assign title_font = blank
  assign title_color = '#000000'
  assign title_line_height = 130
  assign title_font_weight = 700

  if title_block != blank
    assign title_text = title_block.settings.title | default: title_text
    assign title_highlight_color = title_block.settings.title_highlight_color | default: title_highlight_color
    assign title_highlight_enable_custom = title_block.settings.title_highlight_enable_custom | default: false
    assign title_highlight_font = title_block.settings.title_highlight_font
    assign title_highlight_font_weight = title_block.settings.title_highlight_font_weight | default: title_highlight_font_weight
    if title_block.settings.custom_title_font
      assign custom_title_font = true
    endif
    assign title_as = title_block.settings.title_as | default: title_as
    assign title_size_desktop = title_block.settings.title_size_desktop | default: title_size_desktop
    assign title_size_mobile = title_block.settings.title_size_mobile | default: title_size_mobile
    assign title_font = title_block.settings.title_font
    assign title_color = title_block.settings.title_color | default: title_color
    assign title_line_height = title_block.settings.title_line_height | default: title_line_height
    assign title_font_weight = title_block.settings.title_font_weight | default: title_font_weight
  endif

  assign description_text = 'See what customers are saying after their transformations.'
  assign custom_description_font = false
  assign description_as = 'p'
  assign description_size_desktop = 20
  assign description_size_mobile = 18
  assign description_line_height = 150
  assign description_color = '#0B0B0B'
  assign description_top_spacing = 8
  assign description_bottom_spacing = 0
  assign description_margin_top_mobile = 8
  assign description_margin_bottom_mobile = 0

  if description_block != blank
    assign description_text = description_block.settings.description | default: description_text
    assign custom_description_font = description_block.settings.custom_description_font | default: false
    assign description_as = description_block.settings.description_as | default: description_as
    assign description_size_desktop = description_block.settings.description_size_desktop | default: description_size_desktop
    assign description_size_mobile = description_block.settings.description_size_mobile | default: description_size_mobile
    assign description_line_height = description_block.settings.description_line_height | default: description_line_height
    assign description_color = description_block.settings.description_color | default: description_color
    assign description_top_spacing = description_block.settings.description_top_spacing | default: description_top_spacing
    assign description_bottom_spacing = description_block.settings.description_bottom_spacing | default: description_bottom_spacing
    assign description_margin_top_mobile = description_block.settings.description_margin_top_mobile | default: description_margin_top_mobile
    assign description_margin_bottom_mobile = description_block.settings.description_margin_bottom_mobile | default: description_margin_bottom_mobile
  endif

  assign title_margin_top_desktop = 0
  assign title_margin_bottom_desktop = 0
  assign title_margin_top_mobile = 0
  assign title_margin_bottom_mobile = 0

  if title_block != blank
    assign title_margin_top_desktop = title_block.settings.title_margin_top_desktop | default: title_margin_top_desktop
    assign title_margin_bottom_desktop = title_block.settings.title_margin_bottom_desktop | default: title_margin_bottom_desktop
    assign title_margin_top_mobile = title_block.settings.title_margin_top_mobile | default: title_margin_top_mobile
    assign title_margin_bottom_mobile = title_block.settings.title_margin_bottom_mobile | default: title_margin_bottom_mobile
  endif
  
  assign image_border_radius = section.settings.block_border_radius | minus: section.settings.block_border_width
  if image_border_radius < 0
    assign image_border_radius = 0
  endif
-%}

{%- style -%}
  .vd-l { display: none !important; }
  {% if custom_title_font and title_font != blank %}
    {{ title_font | font_face: font_display: 'swap' }}
  {% endif %}
  {{ section.settings.block_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.block_description_font | font_face: font_display: 'swap' }}
  {% if title_highlight_enable_custom and title_highlight_font != blank %}
    {{ title_highlight_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if custom_title_font and title_font != blank %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__title {
      font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
      font-style: {{ title_font.style }};
    }
  {% endif %}

  {% if section.settings.custom_block_title_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__block-title {
      font-family: {{ section.settings.block_title_font.family }}, {{ section.settings.block_title_font.fallback_families }};
      font-style: {{ section.settings.block_title_font.style }};
      line-height: {{ section.settings.block_title_line_height }}%;
      font-size: {{ section.settings.block_title_size_desktop }}px;
      color: {{ section.settings.block_title_color }};
      font-weight: {{ section.settings.block_title_font_weight }};
    }
  {% endif %}

  {% if section.settings.custom_block_description_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__block-description {
      font-family: {{ section.settings.block_description_font.family }}, {{ section.settings.block_description_font.fallback_families }};
      font-style: {{ section.settings.block_description_font.style }};
      line-height: {{ section.settings.block_description_line_height }}%;
      font-size: {{ section.settings.block_description_size_desktop }}px;
      color: {{ section.settings.block_description_color }};
      font-weight: {{ section.settings.block_description_font_weight }};
    }
  {% endif %}

  .vso-testimonials-cards {
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vso-testimonials-cards__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: {{ header_blocks_gap }}px;
    width: 100%;
    position: relative;
  }

  .vso-testimonials-cards__header-content {
    max-width: 60%;
    flex: 1;
  }

  .vso-testimonials-cards__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    {% if rating_badge_bg_enable %}
      background: {{ rating_bg_color }};
    {% endif %}
    border-radius: {{ rating_border_radius }}px;
    {% if rating_badge_bg_enable %}
      padding: {{ rating_padding_vertical }}px {{ rating_padding_horizontal }}px;
      {% if rating_shadow_enable %}
        box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 12px;
      {% endif %}
    {% endif %}
    margin-top: {{ rating_margin_top_mobile }}px;
    margin-bottom: {{ rating_margin_bottom_mobile }}px;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .vso-testimonials-cards__rating {
      margin-top: {{ rating_margin_top_desktop }}px;
      margin-bottom: {{ rating_bottom_spacing }}px;
    }
  }

  {% if custom_rating_header_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__rating {
      color: {{ rating_text_color }};
      font-size: {{ rating_text_size }}px;
    }
  {% endif %}

  .vso-testimonials-cards__rating-stars {
    display: inline-flex;
    gap: {{ section.settings.star_gap }}px;
    font-size: {{ section.settings.star_size }}px;
  }

  .vso-testimonials-cards__rating-stars svg {
    width: {{ rating_star_size }}px;
    height: {{ rating_star_size }}px;
    color: {{ rating_star_color }};
  }

  .vso-testimonials-cards__rating .star-empty svg {
    color: {{ section.settings.star_empty_color }};
  }

  .vso-testimonials-cards__rating-text { margin: 0; line-height: 1; }

  .vso-testimonials-cards__title {
    margin: 0;
    text-align: {{ text_alignment }};
    margin-top: {{ title_margin_top_mobile }}px;
    margin-bottom: {{ title_margin_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .vso-testimonials-cards__title {
      margin-top: {{ title_margin_top_desktop }}px;
      margin-bottom: {{ title_margin_bottom_desktop }}px;
    }
  }

  {% if custom_title_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__title {
      line-height: {{ title_line_height }}%;
      font-size: {{ title_size_desktop }}px;
      color: {{ title_color }};
      font-weight: {{ title_font_weight }};
    }
  {% endif %}
  #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__title .vso-testimonials-cards__title-highlight-{{ section.id }} {
    background: {{ title_highlight_color }} !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
    color: transparent !important;
  }
  {% if title_highlight_enable_custom and title_highlight_font != blank %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__title .vso-testimonials-cards__title-highlight-{{ section.id }} {
      font-family: {{ title_highlight_font.family }}, {{ title_highlight_font.fallback_families }};
      font-style: {{ title_highlight_font.style }};
      font-weight: {{ title_highlight_font_weight }};
    }
  {% endif %}

  .vso-testimonials-cards__description {
    margin: 0;
    text-align: {{ text_alignment }};
    margin-top: {{ description_margin_top_mobile }}px;
    margin-bottom: {{ description_margin_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .vso-testimonials-cards__description {
      margin-top: {{ description_top_spacing }}px;
      margin-bottom: {{ description_bottom_spacing }}px;
    }
  }
  {% if custom_description_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__description {
      font-size: {{ description_size_desktop }}px;
      color: {{ description_color }};
      line-height: {{ description_line_height }}%;
    }
  {% endif %}

  .vso-testimonials-cards__navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.nav_arrow_gap }}px;
  }

  @media screen and (min-width: 750px) {
    {% if section.settings.header_alignment_desktop == 'center' %}
      .vso-testimonials-cards__header {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .vso-testimonials-cards__header-content {
        max-width: 100%;
        text-align: center;
        margin-bottom: 20px;
      }
      .vso-testimonials-cards__title,
      .vso-testimonials-cards__description {
        text-align: center;
      }
    {% endif %}

    {% if section.settings.desktop_nav_position == 'bottom_center' %}
      .vso-testimonials-cards__navigation { display: none; }
      .vso-testimonials-cards__navigation-mobile {
        display: flex !important;
        width: 100%;
        justify-content: center;
        align-items: center;
        margin-top: {{ section.settings.nav_arrow_top_spacing_desktop }}px !important;
      }
      .vso-testimonials-cards__swiper { margin-top: {{ section.settings.cards_top_spacing_desktop }}px; }
      {% unless section.settings.show_navigation_desktop %}
        .vso-testimonials-cards__navigation-mobile { display: none !important; }
      {% endunless %}
    {% else %}
      .vso-testimonials-cards__navigation {
        position: absolute;
        top: 0;
        right: 0;
      }
      .vso-testimonials-cards__navigation-mobile { display: none !important; }
      {% unless section.settings.show_navigation_desktop %}
        .vso-testimonials-cards__navigation { display: none; }
      {% endunless %}
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .vso-testimonials-cards__header {
      flex-direction: column;
      align-items: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}flex-start{% endif %};
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }
    
    .vso-testimonials-cards__header-content {
      max-width: 100%;
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
      margin-bottom: 20px;
    }
    
    .vso-testimonials-cards__title {
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }
    
    .vso-testimonials-cards__description {
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-testimonials-cards__rating {
      white-space: normal;
      flex-wrap: wrap;
      justify-content: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}flex-start{% endif %};
    }

    .vso-testimonials-cards__navigation {
      display: none;
    }
    
    {% unless section.settings.show_navigation_mobile %}
      .vso-testimonials-cards__navigation-mobile {
        display: none;
      }
    {% endunless %}
  }

  .vso-testimonials-cards__swiper {
    width: 100%;
    padding: 5px 0px !important;
    
    overflow: visible;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .vso-testimonials-cards__swiper {
      overflow: visible;
    }
  }

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }

  {% if section.settings.enable_equal_height %}
    .vso-testimonials-cards__swiper {
      height: auto;
    }

    .vso-testimonials-cards__swiper .swiper-wrapper {
      align-items: stretch;
      display: flex;
    }

    .vso-testimonials-cards__swiper .swiper-slide {
      height: auto;
      display: flex;
      flex-direction: column;
    }

    .vso-testimonials-cards__block {
      justify-content: flex-start;
    }

    .vso-testimonials-cards__author-container {
      margin-top: auto;
    }
  {% endif %}

  .vso-testimonials-cards__slide {
    min-width: 0;
    {% if section.settings.enable_equal_height %}
      display: flex;
      height: 100%;
    {% endif %}
  }

  .vso-testimonials-cards__block {
    display: flex;
    flex-direction: column;
    align-items: {{ blocks_alignment_desktop }};
    padding: {{ block_padding }}px;
    background-color: {{ section.settings.block_background_color }};
    border-radius: {{ section.settings.block_border_radius }}px;
    border: {{ section.settings.block_border_width }}px solid {{ section.settings.block_border_color }};
    text-align: {{ blocks_alignment_desktop }};
    transition: transform 0.3s ease;
    overflow: hidden;
    {% if section.settings.enable_equal_height %}
      width: 100%;
      height: 100%;
    {% endif %}
  }

  .vso-testimonials-cards__block-image {
    position: relative;
    width: calc(100% + {{ block_padding | times: 2 }}px + {{ section.settings.block_border_width | times: 2 }}px);
    margin: -{{ block_padding }}px -{{ block_padding }}px {{ section.settings.image_to_content_gap }}px -{{ block_padding }}px;
    margin-top: -{{ block_padding | plus: section.settings.block_border_width }}px;
    margin-left: -{{ block_padding | plus: section.settings.block_border_width }}px;
    margin-right: -{{ block_padding | plus: section.settings.block_border_width }}px;
    border-radius: {{ section.settings.block_border_radius }}px {{ section.settings.block_border_radius }}px 0 0;
    overflow: hidden;
    background-color: {{ section.settings.block_border_color }};
    box-shadow: inset 0 0 0 1px {{ section.settings.block_border_color }};
  }

  .vso-testimonials-cards__image {
    width: 100%;
    height: {{ section.settings.block_image_height_mobile }}px;
    object-fit: cover;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .vso-testimonials-cards__image {
      height: {{ section.settings.block_image_height_desktop }}px;
    }
  }

  .vso-testimonials-cards__block-header-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: {{ blocks_alignment_desktop }};
    gap: {{ stars_title_gap }}px;
  }

  .vso-testimonials-cards__stars {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
    font-size: {{ section.settings.star_size }}px;
    margin: 0 0 {{ section.settings.stars_title_gap }}px 0;
    color: {{ section.settings.star_color }};
  }

  .vso-testimonials-cards__meta-row {
    width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
  }
  .vso-testimonials-cards__meta-row .vso-testimonials-cards__stars { margin: 0; }
  .vso-testimonials-cards__meta-author {
    margin: 0;
    background: {{ section.settings.verified_pill_bg_color }};
    padding: 4px 10px;
    border-radius: 999px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  {% if section.settings.custom_block_author_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__meta-author {
      font-size: {{ section.settings.block_author_size_desktop }}px;
      color: {{ section.settings.block_author_color }};
      font-weight: {{ section.settings.block_author_font_weight }};
    }
  {% endif %}
  .vso-testimonials-cards__meta-author svg { width: {{ section.settings.verified_icon_size }}px; height: {{ section.settings.verified_icon_size }}px; }

  .vso-testimonials-cards__block-title { width: 100%; margin: 0; }

  .vso-testimonials-cards__block-description { width: 100%; margin: 0; margin-top: {{ section.settings.block_description_margin_top }}px; position: relative; }

  .vso-testimonials-cards__product {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid {{ section.settings.product_pill_border_color }};
    background: {{ section.settings.product_pill_bg_color }};
    border-radius: 12px;
    padding: 10px;
    margin-top: 14px;
    text-decoration: none;
    color: inherit;
  }

  .vso-testimonials-cards__product-image {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    background: #f2f2f2;
  }

  .vso-testimonials-cards__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vso-testimonials-cards__product-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.product_elements_gap }}px;
  }

  .vso-testimonials-cards__product-title { margin: 0; }

  .vso-testimonials-cards__product-price { display: flex; align-items: center; gap: 8px; margin: 0; }

  .vso-testimonials-cards__product-compare {
    color: {{ section.settings.product_compare_price_color }};
    text-decoration: line-through;
    font-weight: 600;
  }

  .vso-testimonials-cards__product-purchased { display: flex; align-items: center; gap: 6px; margin: 0; }

  {% if section.settings.custom_product_title_font %}
    #Testimonials-Cards-{{ section.id }} .vso-testimonials-cards__product-title {
      font-family: {{ section.settings.product_title_font.family }}, {{ section.settings.product_title_font.fallback_families }};
      font-style: {{ section.settings.product_title_font.style }};
      line-height: {{ section.settings.product_title_line_height }}%;
      font-size: {{ section.settings.product_title_size_desktop }}px;
