const testimonialsSwiper = new Swiper(swiperEl, {
  loop: true,
  slidesPerView: {{ section.settings.desktop_cards_per_view }},
  spaceBetween: {{ desktop_blocks_gap }},
  grabCursor: true,
  speed: 600,
  
  {% if section.settings.enable_equal_height %}
  watchSlidesProgress: true,
  {% endif %}
  
  navigation: {
    nextEl: sectionEl.querySelector('.vso-testimonials-cards__nav-next'),
    prevEl: sectionEl.querySelector('.vso-testimonials-cards__nav-prev'),
  },
  
  breakpoints: {
    0: {
      spaceBetween: {{ mobile_blocks_gap }},
      centeredSlides: false,
      slidesPerView: 'auto',
      slidesOffsetBefore: 0,
      slidesOffsetAfter: 60,
    },
    750: {
      spaceBetween: {{ desktop_blocks_gap }},
      centeredSlides: false,
      slidesPerView: {{ section.settings.desktop_cards_per_view }},
    }
  }{% if section.settings.enable_equal_height %},
  
  on: {
    init: function() {
      setTimeout(() => {
        this.updateSlidesClasses();
        equalizeSlideHeights();
      }, 100);
    },
    slideChangeTransitionEnd: function() {
      equalizeSlideHeights();
    }
  }{% endif %}
});

{% if section.settings.enable_equal_height %}
function equalizeSlideHeights() {
  const slides = document.querySelectorAll('.vso-testimonials-cards__swiper .swiper-slide');
  const blocks = document.querySelectorAll('.vso-testimonials-cards__swiper .vso-testimonials-cards__block');
  
  if (slides.length === 0 || blocks.length === 0) return;
  
  blocks.forEach(block => {
    block.style.height = 'auto';
  });
  
  let maxHeight = 0;
  blocks.forEach(block => {
    const height = block.offsetHeight;
    if (height > maxHeight) {
      maxHeight = height;
    }
  });
  
  blocks.forEach(block => {
    block.style.height = maxHeight + 'px';
  });
}

window.addEventListener('resize', function() {
  setTimeout(equalizeSlideHeights, 100);
});
{% endif %}

const mobileNavPrev = sectionEl.querySelector('.vso-testimonials-cards__nav-prev-mobile');
const mobileNavNext = sectionEl.querySelector('.vso-testimonials-cards__nav-next-mobile');

if (mobileNavPrev) {
  mobileNavPrev.addEventListener('click', function() {
    testimonialsSwiper.slidePrev();
  });
}

if (mobileNavNext) {
  mobileNavNext.addEventListener('click', function() {
    testimonialsSwiper.slideNext();
  });
}
});
</script>

