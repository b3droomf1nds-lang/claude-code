<div class="section-{{ section.id }} vso-node vd-l vso-hidden">
<div class="section-{{ section.id }}-settings">
  <div class="vso-testimonials-cards" id="Testimonials-Cards-{{ section.id }}">
    <div class="vso-testimonials-cards__header">
      <div class="vso-testimonials-cards__header-content">
        {% if rating_block != blank %}
          <div class="vso-testimonials-cards__rating" {{ rating_block.shopify_attributes }}>
            <span class="vso-testimonials-cards__rating-stars" aria-hidden="true">
              {%- liquid
                assign rating = header_star_rating | default: 5
                assign full_stars = rating | floor
                assign half_star = rating | modulo: 1
                assign empty_stars = 5 | minus: full_stars
                if half_star >= 0.5
                  assign empty_stars = empty_stars | minus: 1
                endif
              -%}

              {% for i in (1..full_stars) %}
                <span class="star star-filled">
                  <svg viewBox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg" fill="none" width="1em" height="1em" style="display:block;">
                    <g id="SVGRepo_bgCarrier" stroke-width="0" transform="translate(1.2,1.2), scale(0.9)">
                      <rect x="-2.4" y="-2.4" width="28.80" height="28.80" rx="0" fill="{{ rating_star_background_color }}" strokewidth="0"></rect>
                    </g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                      <rect x="0" fill="none" width="24" height="24"></rect>
                      <g>
                        <path d="M12 2l2.582 6.953L22 9.257l-5.822 4.602L18.18 21 12 16.89 5.82 21l2.002-7.14L2 9.256l7.418-.304" fill="currentColor"></path>
                      </g>
                    </g>
                  </svg>
                </span>
              {% endfor %}

              {% if half_star >= 0.5 %}
                <span class="star star-half">
                  <svg viewBox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
                    <defs>
                      <linearGradient id="half-rating-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="50%" style="stop-color:{{ rating_star_background_color }};stop-opacity:1" />
                        <stop offset="50%" style="stop-color:{{ rating_star_empty_background_color }};stop-opacity:1" />
                      </linearGradient>
                    </defs>
                    <g id="SVGRepo_bgCarrier" stroke-width="0" transform="translate(1.2,1.2), scale(0.9)">
                      <rect x="-2.4" y="-2.4" width="28.80" height="28.80" rx="0" fill="url(#half-rating-{{ section.id }})" strokewidth="0"></rect>
                    </g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                      <rect x="0" fill="none" width="24" height="24"></rect>
                      <g>
                        <path d="M12 2l2.582 6.953L22 9.257l-5.822 4.602L18.18 21 12 16.89 5.82 21l2.002-7.14L2 9.256l7.418-.304" fill="currentColor"></path>
                      </g>
                    </g>
                  </svg>
                </span>
              {% endif %}

              {% for i in (1..empty_stars) %}
                <span class="star star-empty">
                  <svg viewBox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg" fill="none" width="1em" height="1em" style="display:block;">
                    <g id="SVGRepo_bgCarrier" stroke-width="0" transform="translate(1.2,1.2), scale(0.9)">
                      <rect x="-2.4" y="-2.4" width="28.80" height="28.80" rx="0" fill="{{ rating_star_empty_background_color }}" strokewidth="0"></rect>
                    </g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                      <rect x="0" fill="none" width="24" height="24"></rect>
                      <g>
                        <path d="M12 2l2.582 6.953L22 9.257l-5.822 4.602L18.18 21 12 16.89 5.82 21l2.002-7.14L2 9.256l7.418-.304" fill="currentColor"></path>
                      </g>
                    </g>
                  </svg>
                </span>
              {% endfor %}
            </span>
            {% if custom_rating_header_font %}
              <p class="vso-testimonials-cards__rating-text">{{ rating_header_text }}</p>
            {% else %}
              <{{ rating_header_as }} class="vso-testimonials-cards__rating-text">{{ rating_header_text }}</{{ rating_header_as }}>
            {% endif %}
          </div>
        {% endif %}
        {% if title_text != blank and title_block != blank %}
          {%- liquid
            assign title_parts = title_text | split: '_'
            assign processed_title = ''
            assign is_highlighted = false
            for part in title_parts
              if is_highlighted
                capture highlighted_part
                  echo '<span class="vso-testimonials-cards__title-highlight-' | append: section.id | append: '">' | append: part | append: '</span>'
                endcapture
                assign processed_title = processed_title | append: highlighted_part
                assign is_highlighted = false
              else
                assign processed_title = processed_title | append: part
