<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F5F5F7">
  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t }} {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  {{ 'theme-r2.css' | asset_url | stylesheet_tag }}
  <style>
    /* Guard: never allow sideways scrolling on any page — an
       overflowing element gets clipped instead of widening the page. */
    html, body { overflow-x: hidden; overflow-x: clip; }

    /* Site-wide overrides: Inter as the body font, Apple-style off-white
       canvas, white/light footer, white newsletter "Join" button. */
    :root{ --sans:'Inter',-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif; --base:#F5F5F7; }
    html, body, main{ background:var(--base) !important; }
    .spotlight{ background:var(--base) !important; }
    /* Several headings/badges explicitly set 'Voltical Relay' as the first
       font (which wins over the --sans fallback above) — force those back
       to Inter too so the whole store is consistently Inter. */
    .t-hero, .t-xl, .product-card__word, .product-card::after,
    .fdark__heading, .fdark__stat-value { font-family: var(--sans) !important; }
    .site-footer{ background:var(--base) !important; color:var(--ink) !important; }
    .site-footer a{ color:rgba(19,19,22,.6) !important; }
    .site-footer a:hover{ color:var(--lilac-m) !important; }
    .site-footer__brand .t-whisper{ color:rgba(19,19,22,.85) !important; }
    .site-footer h4{ color:rgba(19,19,22,.45) !important; }
    .newsletter{ background:rgba(19,19,22,.06) !important; }
    .newsletter input{ color:var(--ink) !important; }
    .newsletter input::placeholder{ color:rgba(19,19,22,.4) !important; }
    .newsletter button{ background:var(--base) !important; color:var(--ink) !important; box-shadow:inset 0 0 0 1px rgba(19,19,22,.15) !important; }
    .newsletter button:hover{ background:#fff !important; box-shadow:inset 0 0 0 1px rgba(19,19,22,.28) !important; }
    .site-footer__legal{ color:rgba(19,19,22,.4) !important; }

    /* Temporarily hiding the icons on the "benefits" row (Tested before it
       ships / warranty / returns / support). Remove this rule to bring
       them back — flexbox will re-open the gap for them automatically. */
    .standard__item h3 svg{ display:none !important; }
  </style>

  <script>
    window.Voltical = {
      moneyFormat: {{ shop.money_format | json }},
      cartUrl: {{ routes.cart_url | json }},
      protection: {
        handle: {{ settings.protection_handle | json }},
        thresholds: {{ settings.protection_thresholds | default: '50,100,150' | json }},
        enabled: {{ settings.protection_enabled | json }}
      },
      dispatchCutoffHour: {{ settings.dispatch_cutoff | default: 14 }}
    };
    window.VolticalStrings = {
      added: {{ 'products.added' | t | json }},
      soldOut: {{ 'products.sold_out' | t | json }},
      unavailable: {{ 'products.unavailable' | t | json }},
      error: {{ 'general.error' | t | json }},
      remove: {{ 'cart.remove' | t | json }}
    };
  </script>
  {{ 'voltical-data.js' | asset_url | script_tag }}
  <script src="{{ 'theme-r2.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  <div class="page-scrim" data-scrim hidden></div>
</body>
</html>
