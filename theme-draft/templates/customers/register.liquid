<div class="page-narrow" style="max-width:420px">
  <h1 class="t-lg" style="margin-bottom:24px">{{ 'customer.create_account' | t }}</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="{{ 'customer.first_name' | t }}" style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:12px">
    <input type="text" name="customer[last_name]" placeholder="{{ 'customer.last_name' | t }}" style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:12px">
    <input type="email" name="customer[email]" placeholder="{{ 'customer.email' | t }}" required style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:12px">
    <input type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}" required style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:24px">
    <button class="btn btn--ink btn--full" type="submit">{{ 'customer.create_account' | t }}</button>
  {% endform %}
</div>
