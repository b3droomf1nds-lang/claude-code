<div class="page-narrow" style="max-width:420px">
  <h1 class="t-lg" style="margin-bottom:24px">{{ 'customer.reset' | t }}</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}" required style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:12px">
    <input type="password" name="customer[password_confirmation]" placeholder="{{ 'customer.password_confirm' | t }}" required style="width:100%;padding:13px 16px;border:1px solid var(--ink-12);border-radius:8px;margin-bottom:24px">
    <button class="btn btn--ink btn--full" type="submit">{{ 'customer.reset' | t }}</button>
  {% endform %}
</div>
