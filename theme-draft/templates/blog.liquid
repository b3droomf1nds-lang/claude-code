<div class="page-narrow">
  <h1 class="t-lg" style="margin-bottom:32px">{{ blog.title }}</h1>
  {% paginate blog.articles by 12 %}
  {% for article in blog.articles %}
    <article style="padding:24px 0;border-bottom:1px solid var(--ink-12)">
      <a href="{{ article.url }}" class="t-md" style="font-weight:600">{{ article.title }}</a>
      <p class="t-muted" style="font-size:.85rem;margin:6px 0 0">{{ article.published_at | date: '%B %d, %Y' }}</p>
    </article>
  {% endfor %}
  {% endpaginate %}
</div>
