<aside class="drawer" data-drawer role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
  <div class="drawer__head">
    <h2>{{ 'cart.title' | t }}</h2>
    <button class="drawer__close" data-drawer-close aria-label="{{ 'general.close' | t }}"><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.2 2.2l7.6 7.6M9.8 2.2l-7.6 7.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
  </div>

  <div class="drawer__body">
    <div class="drawer__empty" data-drawer-empty hidden>
      <p class="t-md" style="margin-bottom:8px">{{ 'cart.empty' | t }}</p>
      <p class="t-muted" style="font-size:.9rem;margin:0 0 24px">{{ 'cart.empty_sub' | t }}</p>
    </div>

    <div data-drawer-lines></div>

    <div class="ship-bubble" data-ship hidden>
      <span class="ship-bubble__icon"><svg width="24" height="24" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M6.69 2.79 Q9.00 1.60 11.31 2.79 L13.55 3.94 Q14.97 4.68 13.55 5.41 L9.98 7.25 Q9.00 7.75 8.02 7.25 L4.45 5.41 Q3.03 4.68 4.45 3.94 Z M2.40 7.25 Q2.40 5.65 3.82 6.38 L7.45 8.25 Q8.43 8.75 8.43 9.85 L8.43 14.50 Q8.43 16.10 7.00 15.37 L4.71 14.19 Q2.40 13.00 2.40 10.40 Z M14.18 6.38 Q15.60 5.65 15.60 7.25 L15.60 10.40 Q15.60 13.00 13.29 14.19 L11.00 15.37 Q9.57 16.10 9.57 14.50 L9.57 9.85 Q9.57 8.75 10.55 8.25 Z" fill="currentColor"/></svg></span>
      <div class="ship-bubble__body">
        <span class="ship-bubble__label">{{ 'cart.shipping' | t }}</span>
        <span class="ship-bubble__method" data-ship-method></span>
      </div>
      <span class="ship-bubble__price" data-ship-price></span>
    </div>

    <div class="addon" data-protect hidden>
      <span class="addon__icon">{% render 'icon', icon: 'shield' %}</span>
      <div class="addon__body">
        <div class="addon__title">
          {{ 'cart.protect_title' | t }}
          <span class="addon__price" data-protect-price></span>
        </div>
        <p class="addon__desc">{{ 'cart.protect_desc' | t }}</p>
      </div>
      <label class="switch">
        <input type="checkbox" aria-label="{{ 'cart.protect_title' | t }}">
        <i></i>
      </label>
    </div>
  </div>

  <div class="drawer__foot" data-drawer-foot hidden>
    <div class="drawer__subtotal">
      <span data-total-label>{{ 'cart.subtotal' | t }}</span>
      <span data-drawer-subtotal></span>
    </div>
    <p class="drawer__hint" data-total-hint>{{ 'cart.taxes_note' | t }}</p>
    <a class="btn btn--accent drawer__checkout" href="{{ routes.cart_url }}/checkout">{{ 'cart.checkout' | t }}</a>
  </div>
</aside>
