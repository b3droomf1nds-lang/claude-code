{%- comment -%}
  Compact "select your iPhone, see the numbers" block — same visual
  pattern as Apple's own compare row, sized to sit inline in the narrow
  buy column (in the gap above the stat tiles) instead of breaking out
  full-width. The dropdown lists every iPhone generation from the X
  onward, purely for the "which phone do you have" framing — the stat
  grid itself is Core's own numbers and doesn't change per model since
  Core works the same across all of them.
{%- endcomment -%}
<div class="pdp-cmp-wrap">
<div class="pdp-cmp">
  <div class="pdp-cmp__select-group">
    <p class="pdp-cmp__select-heading">See how Core upgrades your experience</p>
    <label class="pdp-cmp__label" for="pdp-cmp-select">Select your iPhone:</label>
    <div class="pdp-cmp__select-wrap">
      <select class="pdp-cmp__select" id="pdp-cmp-select">
        <option>iPhone X</option>
        <option>iPhone XS</option>
        <option>iPhone XS Max</option>
        <option>iPhone XR</option>
        <option>iPhone 11</option>
        <option>iPhone 11 Pro</option>
        <option>iPhone 11 Pro Max</option>
        <option>iPhone 12 mini</option>
        <option>iPhone 12</option>
        <option>iPhone 12 Pro</option>
        <option>iPhone 12 Pro Max</option>
        <option>iPhone 13 mini</option>
        <option>iPhone 13</option>
        <option>iPhone 13 Pro</option>
        <option>iPhone 13 Pro Max</option>
        <option>iPhone 14</option>
        <option>iPhone 14 Plus</option>
        <option>iPhone 14 Pro</option>
        <option>iPhone 14 Pro Max</option>
        <option>iPhone 15</option>
        <option>iPhone 15 Plus</option>
        <option>iPhone 15 Pro</option>
        <option>iPhone 15 Pro Max</option>
        <option>iPhone 16</option>
        <option>iPhone 16 Plus</option>
        <option>iPhone 16 Pro</option>
        <option>iPhone 16 Pro Max</option>
        <option>iPhone 16e</option>
        <option>iPhone Air</option>
        <option>iPhone 17</option>
        <option>iPhone 17 Pro</option>
        <option>iPhone 17 Pro Max</option>
      </select>
    </div>
  </div>

  {%- comment -%}
    3 of the 6 cards are live numbers driven off the iPhone dropdown
    above (and, on products that have one, the mAh capacity variant):
    20->80% charge time at both devices' fastest mode, how many full
    0->100% charges the powerbank has in it, and how many quick
    20->80% top-ups it can do instead — with a note that the latter is
    the realistic everyday case. See the <script> below for the math +
    the per-model battery data it's built from.
  {%- endcomment -%}
  <div class="pdp-cmp__grid">
    <div class="pdp-cmp__card"><div class="pdp-cmp__label-only">Half the size in your pocket</div></div>
    <div class="pdp-cmp__card pdp-cmp__card--img pdp-cmp__card--charge">
      <div class="pdp-cmp__eyebrow">Up to</div>
      <div class="pdp-cmp__stat-row"><div class="pdp-cmp__stat" data-calc-time>&mdash;</div><svg class="pdp-cmp__battery-icon" viewBox="0 0 54 28" aria-hidden="true" style="color:#16c76a;"><rect x="1.5" y="2.5" width="45" height="23" rx="6" fill="none" stroke="currentColor" stroke-width="3"/><rect x="49" y="9" width="4" height="10" rx="2" fill="currentColor"/><rect x="6" y="7" width="36" height="14" rx="3.5" fill="currentColor"/></svg></div>
      <div class="pdp-cmp__sub pdp-cmp__sub--unit">minutes</div>
      <div class="pdp-cmp__sub pdp-cmp__sub--range">20% to 80%</div>
    </div>
    <div class="pdp-cmp__card pdp-cmp__card--hero pdp-cmp__card--img pdp-cmp__card--fade">
      <div class="pdp-cmp__eyebrow">Up to</div>
      <div class="pdp-cmp__stat" data-calc-full>&mdash;</div>
      <div class="pdp-cmp__sub">full charges</div>
      {%- comment -%} image drops in here — leave empty until it's supplied {%- endcomment -%}
      <div class="pdp-cmp__img-slot" aria-hidden="true"><img class="pdp-cmp__img--full-upright" src="https://cdn.shopify.com/s/files/1/0968/2337/8246/files/Untitled_design_5.webp?v=1786195688" alt="Core powerbank and phone side profile"></div>
    </div>
    <div class="pdp-cmp__card pdp-cmp__card--img pdp-cmp__card--video">
      <div class="pdp-cmp__sub">Reversible magnetic fit</div>
      <div class="pdp-cmp__sub pdp-cmp__sub--alloy">Ultra compact alloy shell</div>
      <div class="pdp-cmp__img-slot" aria-hidden="true"><img class="pdp-cmp__img--video-crop" src="https://cdn.shopify.com/s/files/1/0968/2337/8246/files/core-pro-black-transparent-crop-v5.png?v=1786281736" alt="Core Pro black case camera detail"></div>
    </div>
    <div class="pdp-cmp__card pdp-cmp__card--img pdp-cmp__card--partial-image">
      <div class="pdp-cmp__eyebrow">Up to</div>
      <div class="pdp-cmp__stat" data-calc-partial>&mdash;</div>
      <div class="pdp-cmp__img-slot" aria-hidden="true"><img class="pdp-cmp__img--partial-hand" src="https://cdn.shopify.com/s/files/1/0968/2337/8246/files/core-side-hand-latest.png?v=1786145447" alt="Core powerbank held at the side"></div>
      <div class="pdp-cmp__sub pdp-cmp__sub--partial-range" style="bottom: 8px;">20% to 80%</div>
    </div>
    <div class="pdp-cmp__card pdp-cmp__card--hero pdp-cmp__card--img pdp-cmp__card--fade">
      <div class="pdp-cmp__eyebrow">Up to</div>
      <div class="pdp-cmp__stat" data-calc-video>&mdash;</div>
      <div class="pdp-cmp__sub">video playback</div>
    </div>
  </div>
</div>
</div>

<script>
(function () {
  var PHONES = {
    'iPhone X': [2.716, 18, 13], 'iPhone XS': [2.658, 18, 14], 'iPhone XS Max': [3.174, 18, 15],
    'iPhone XR': [2.942, 18, 16], 'iPhone 11': [3.110, 18, 17], 'iPhone 11 Pro': [3.046, 18, 18],
    'iPhone 11 Pro Max': [3.969, 18, 20], 'iPhone 12 mini': [2.227, 20, 15], 'iPhone 12': [2.815, 20, 17],
    'iPhone 12 Pro': [2.815, 20, 17], 'iPhone 12 Pro Max': [3.687, 20, 20], 'iPhone 13 mini': [2.406, 20, 17],
    'iPhone 13': [3.227, 20, 19], 'iPhone 13 Pro': [3.095, 20, 22], 'iPhone 13 Pro Max': [4.352, 20, 28],
    'iPhone 14': [3.279, 20, 20], 'iPhone 14 Plus': [4.325, 20, 26], 'iPhone 14 Pro': [3.200, 27, 23],
    'iPhone 14 Pro Max': [4.323, 27, 29], 'iPhone 15': [3.349, 20, 20], 'iPhone 15 Plus': [4.383, 20, 26],
    'iPhone 15 Pro': [3.274, 27, 23], 'iPhone 15 Pro Max': [4.441, 27, 29], 'iPhone 16': [3.561, 20, 22],
    'iPhone 16 Plus': [4.674, 20, 27], 'iPhone 16 Pro': [3.582, 27, 27], 'iPhone 16 Pro Max': [4.685, 27, 33],
    'iPhone 16e': [3.961, 18, 26], 'iPhone Air': [3.100, 27, 27], 'iPhone 17': [3.700, 27, 30],
    'iPhone 17 Pro': [3.800, 27, 31], 'iPhone 17 Pro Max': [5.000, 40, 39]
  };
  var POWERBANK_MAX_W = 20;
  var DC_EFFICIENCY = 0.85;
  var PHONE_NOMINAL_V = 3.85;
  var TAPER_FACTOR = 0.45;

  var select = document.getElementById('pdp-cmp-select');
  var timeEl = document.querySelector('[data-calc-time]');
  var fullEl = document.querySelector('[data-calc-full]');
  var partialEl = document.querySelector('[data-calc-partial]');
  var videoEl = document.querySelector('[data-calc-video]');
  if (!select || !timeEl || !fullEl || !partialEl || !videoEl) return;

  function powerbankWh() {
    var checked = document.querySelector('input[type="radio"]:checked[value*="mAh" i]')
      || document.querySelector('input[type="radio"][value*="mAh" i]');
    var mah = 10000;
    if (checked) {
      var n = checked.value.replace(/[^0-9.]/g, '');
      if (n) mah = parseFloat(n);
    }
    return mah * 3.7 / 1000;
  }

  function fmt(n) {
    return (Math.round(n * 10) / 10).toString().replace(/\.0$/, '');
  }

  function update() {
    var phone = PHONES[select.value] || PHONES['iPhone 15'];
    var phoneWh = phone[0] * PHONE_NOMINAL_V, phoneMaxW = phone[1], phoneVideoH = phone[2];
    var pbWh = powerbankWh();

    var full = (pbWh * DC_EFFICIENCY) / phoneWh;
    var partial = full / 0.6;
    var videoHours = full * phoneVideoH;

    var effW = Math.min(phoneMaxW, POWERBANK_MAX_W) * TAPER_FACTOR;
    var minutes = (0.6 * phoneWh) / effW * 60;

    fullEl.textContent = fmt(full) + '×';
    partialEl.textContent = fmt(partial) + '×';
    videoEl.textContent = Math.round(videoHours) + 'h more';
    timeEl.textContent = Math.round(minutes);
  }

  select.addEventListener('change', update);
  document.querySelectorAll('input[type="radio"][value*="mAh" i]').forEach(function (el) {
    el.addEventListener('change', update);
  });
  update();
})();
</script>
