      dragging = {el:sel, mode:'scale', id:id, d0:d0, s0:st.s, dx0:st.dx, dy0:st.dy, cx:c.x, cy:c.y, batch:captureBatch([sel])};
      setTouchActive(sel);
    }
    function endDragging(cancelled){
      flushTouchSample();
      if (!dragging){ setTouchActive(null); return; }
      var ended = dragging;
      saveState(ended.el, stateOf(ended.el));
      positionBox();
      if (ended.batch) commitBatch(ended.batch);
      dragging = null;
      setTouchActive(null);
    }
    function startPinch(t0, t1){
      pinch = {el:sel, id1:t0.identifier, id2:t1.identifier,
               d0: Math.hypot(t1.clientX - t0.clientX, t1.clientY - t0.clientY) || 1,
               s0: stateOf(sel).s, batch: captureBatch([sel])};
      setTouchActive(sel);
    }
    function endPinch(){
      flushTouchSample();
      if (!pinch){ setTouchActive(null); return; }
      var ended = pinch;
      saveState(ended.el, stateOf(ended.el));
      positionBox();
      if (ended.batch) commitBatch(ended.batch);
      pinch = null;
      setTouchActive(null);
    }
    function resolveTap(p){
      var hit = p.el, card = p.card, now = Date.now();
      // A clean tap on the same drilled child toggles its selection off.
      // This runs only after touchend, so pressing and moving still starts a
      // drag; whole tiles keep their normal one-tap selection behaviour.
      // Forget the previous tap as well, otherwise the next fresh tap could
      // be mistaken for the second half of the old double-tap.
      if (card && sel && sel !== card && (sel === hit || sel.contains(hit))){
        lastTap = null;
        deselect();
        return;
      }
      // Treat two nearby taps in the same tile as a double even if finger
      // jitter lands on a neighbouring nested node. A whole-tile tap can
      // optimistically deselect immediately; retaining this tap record lets
      // a fast second tap still drill into the intended child.
      var sameArea = lastTap && (card ? lastTap.card === card : lastTap.el === hit);
      var closeEnough = lastTap && Math.hypot(p.x - lastTap.x, p.y - lastTap.y) < 48;
      var dbl = !!(sameArea && closeEnough && (now - lastTap.t) < 340);
      lastTap = {el:hit, card:card, x:p.x, y:p.y, t:now};
      if (card && sel === card && !dbl){
        deselect();
        return;
      }
      // A rapid second tap on blank card space has nothing deeper to drill
      // into, so it is still a tile toggle rather than a no-op double-tap.
      if (card && sel === card && dbl && hit === card){
        lastTap = null;
        deselect();
        return;
      }
      var t;
      if (!card) t = hit;                       // heading / selector
      else if (dbl) t = hit;                    // double-tap drills any child, including text
      else if (sel && sel !== card && (sel === hit || sel.contains(hit))) t = sel; // keep drilled child
      else t = card;                            // single tap → whole tile
      select(t);
    }
    function onTouchStart(e){
      if (!touchInputSeen){ touchInputSeen = true; updateEditTextButton(); }
      if (e.touches.length > 1){
        lastTap = null;
        // Once an editor pinch exists, suppress native handling before any
        // reads/writes. A third finger does not restart the tracked pair.
        if (sel) e.preventDefault();
        if (pinch) return;
        // Commit an active caption edit before opening the pinch undo batch.
        // Otherwise the two histories overlap and a later text undo can also
        // roll back the scale change made by this gesture.
        if (editingEl) exitTextEdit();
        // A second finger landing — whatever single-finger gesture was in
        // progress ends cleanly right here (committed, not abandoned mid-
        // motion) and a fresh two-finger pinch-resize takes over. Without
        // this, a stray extra finger (e.g. a resting thumb) mid-drag would
        // leave touches[0] pointing at a DIFFERENT finger than the one
        // actually being tracked, which is what made a dragged image
        // suddenly jump/"fly" — every gesture below is now tracked by its
        // own touch identifier instead of always trusting touches[0].
        pendingTap = null;
        if (dragging){
          var handoff = findTouch(e.touches, dragging.id);
          if (handoff) queueTouchSample({kind:'drag', gesture:dragging, x:handoff.clientX, y:handoff.clientY});
        }
        endDragging();
        if (sel) startPinch(e.touches[0], e.touches[1]);
        return;
      }
      var pt = e.touches[0];
      var target = document.elementFromPoint(pt.clientX, pt.clientY) || e.target;
      if (editingEl && !editingEl.contains(target)) exitTextEdit();
      if (target.closest('.cv-tb, .cv-panel')){ lastTap = null; return; } // toolbar taps behave natively
      if (editingEl) return;
      var handle = target.closest('.cv-h');
      if (handle && sel){ lastTap = null; e.preventDefault(); startResizeT(pt.clientX, pt.clientY, handle.dataset.corner, pt.identifier); return; }
      var hit = target.closest(EDITABLE);
      if (!hit || !root.contains(hit)){ lastTap = null; pendingTap = null; deselect(); return; }
      var touchingSelection = sel && (sel === hit || sel.contains(hit));
      // Claim a selected movable element at touchstart, before Safari can
      // begin a scroll chain. Its transform now starts from this exact point
      // too, rather than waiting for the tap threshold and then jumping.
      // Unselected content stays native so it scrolls.
      if (touchingSelection && touchCanMove(sel)){
        e.preventDefault();
        dragging = makeMoveT(sel, pt.clientX, pt.clientY, true, pt.identifier);
        if (dragging) setTouchActive(sel);
      }
      pendingTap = {el:hit, card:hit.closest('.pdp-cmp__card'), x:pt.clientX, y:pt.clientY, id:pt.identifier};
    }
    function onTouchMove(e){
      if (pinch){
        e.preventDefault();
        var pt0 = findTouch(e.touches, pinch.id1), pt1 = findTouch(e.touches, pinch.id2);
        if (!pt0 || !pt1) return; // one of the two tracked fingers isn't in this event — ignore, wait for touchend
        var dist = Math.hypot(pt1.clientX - pt0.clientX, pt1.clientY - pt0.clientY);
        queueTouchSample({kind:'pinch', gesture:pinch, dist:dist});
        return;
      }
      if (dragging){
        e.preventDefault();
        var p = findTouch(e.touches, dragging.id); if (!p) return; // not the tracked finger
        // Keep the small threshold only for classifying a clean tap. The
        // rendered drag itself already began at touchstart, so crossing it
        // cannot produce a delayed jump under the finger.
        if (pendingTap && pendingTap.id === dragging.id &&
            Math.hypot(p.clientX - pendingTap.x, p.clientY - pendingTap.y) > 4){
          pendingTap = null;
          lastTap = null;
        }
        queueTouchSample({kind:'drag', gesture:dragging, x:p.clientX, y:p.clientY});
        return;
      }
      if (pendingTap){
        var q = findTouch(e.touches, pendingTap.id); if (!q) return;
        if (Math.hypot(q.clientX - pendingTap.x, q.clientY - pendingTap.y) > 4){
          lastTap = null;
          // moved past the tap threshold: if it's on the current selection,
          // this is a move-drag; otherwise it's a page scroll — let it go.
          if (sel && touchCanMove(sel) && (sel === pendingTap.el || sel.contains(pendingTap.el))){
            e.preventDefault();
            // Start from the original finger-down point, not this threshold-
            // crossing sample. Replaying the full delta removes the old
            // permanent 8px finger/element offset.
            dragging = makeMoveT(sel, pendingTap.x, pendingTap.y, true, pendingTap.id);
            if (dragging){
              setTouchActive(sel);
              queueTouchSample({kind:'drag', gesture:dragging, x:q.clientX, y:q.clientY});
            }
          }
          pendingTap = null;
        }
      }
    }
    function onTouchEnd(e){
      if (pinch){
        e.preventDefault();
        var live0 = findTouch(e.touches, pinch.id1);
        var live1 = findTouch(e.touches, pinch.id2);
        // End as soon as either tracked finger lifts. Two unrelated fingers
        // may still be down, but silently switching the tracked pair would
        // introduce a scale jump.
        if (!live0 || !live1){
          var p0 = live0 || findTouch(e.changedTouches, pinch.id1);
          var p1 = live1 || findTouch(e.changedTouches, pinch.id2);
          if (p0 && p1){
            queueTouchSample({kind:'pinch', gesture:pinch,
              dist:Math.hypot(p1.clientX - p0.clientX, p1.clientY - p0.clientY)});
          }
          endPinch();
        }
        return;
      }
      if (pendingTap){
        // Suppress the compatibility mouse/click sequence; without this a
        // phone tap also runs the desktop handlers after resolveTap().
        e.preventDefault();
        var tapped = pendingTap;
        pendingTap = null;
        // A tap may have produced a few pixels of live preview while the
        // finger settled. It was never a deliberate move, so discard that
        // preview before resolving the normal select/deselect action.
        if (dragging && dragging.id === tapped.id){
          discardTouchSample();
          restorePreviewBatch(dragging.batch);
          dragging = null;
        }
        resolveTap(tapped);
        setTouchActive(null);
        return;
      }
      if (dragging && !findTouch(e.touches, dragging.id)){
        e.preventDefault();
        var last = findTouch(e.changedTouches, dragging.id);
        if (last) queueTouchSample({kind:'drag', gesture:dragging, x:last.clientX, y:last.clientY});
        endDragging(false);
      }
    }
    function onTouchCancel(e){
      lastTap = null;
      pendingTap = null; // a cancelled touch is never a tap/double-tap
      if (pinch){
        var live0 = findTouch(e.touches, pinch.id1);
        var live1 = findTouch(e.touches, pinch.id2);
        if (live0 && live1) return; // only an untracked third touch cancelled
        e.preventDefault();
        var p0 = live0 || findTouch(e.changedTouches, pinch.id1);
        var p1 = live1 || findTouch(e.changedTouches, pinch.id2);
        if (p0 && p1){
          queueTouchSample({kind:'pinch', gesture:pinch,
            dist:Math.hypot(p1.clientX - p0.clientX, p1.clientY - p0.clientY)});
        }
        endPinch();
        return;
      }
      if (dragging){
        if (findTouch(e.touches, dragging.id)) return; // unrelated touch cancelled
        e.preventDefault();
        var last = findTouch(e.changedTouches, dragging.id);
        if (last) queueTouchSample({kind:'drag', gesture:dragging, x:last.clientX, y:last.clientY});
        endDragging(true);
        return;
      }
      discardTouchSample();
      setTouchActive(null);
    }
    document.addEventListener('touchstart', onTouchStart, {passive:false, capture:true});
    document.addEventListener('touchmove', onTouchMove, {passive:false, capture:true});
    document.addEventListener('touchend', onTouchEnd, {passive:false, capture:true});
    document.addEventListener('touchcancel', onTouchCancel, {passive:false, capture:true});

    window.addEventListener('scroll', positionBox, true);
    window.addEventListener('resize', positionBox);

    // ---- wheel to resize the selected element ----
    // A scroll gesture fires many wheel events in a burst — treat the whole
    // burst as one undo step (capture once at the start, commit once
    // ~400ms after the wheel goes quiet) instead of one per tick.
    var wheelBatch = null, wheelIdleTimer = null;
    document.addEventListener('wheel', function(e){
      if (!sel || editingEl) return;
      var r = sel.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
      e.preventDefault();
      if (!wheelBatch) wheelBatch = captureBatch([sel]);
      clearTimeout(wheelIdleTimer);
      wheelIdleTimer = setTimeout(function(){ commitBatch(wheelBatch); wheelBatch = null; }, 400);
      var st = stateOf(sel);
      st.s = Math.max(0.15, Math.min(10, st.s * (e.deltaY < 0 ? 1.05 : 0.9524)));
      saveState(sel, st); positionBox();
    }, {passive:false});

    // ---- arrow-key nudge (and typing, when a caption is being edited) ----
    document.addEventListener('keydown', function(e){
      if (editingEl){
        if (e.key === 'Enter'){
          e.preventDefault();
          insertLineBreak();
          saveText(editingEl);
        } else if (e.key === 'Escape'){
          e.preventDefault();
          exitTextEdit();
        }
        return; // every other key (letters, backspace, arrow-to-move-cursor...) behaves natively
      }
      if (!sel) return;
      // A selected caption is still draggable by holding the mouse on it
      // (same as any other selected element) — Enter is what switches it
      // into typing, so the two never compete for the same click.
      if (e.key === 'Enter' && isTextEditable(sel)){ e.preventDefault(); enterTextEdit(sel); return; }
      // Backspace/Delete on a SELECTED (not currently-typed-into) text box
      // clears it — same idea as pressing Enter to type, just the opposite:
      // one keypress, not held down, no confirm dialog, because it's a
      // single undo-able step either way.
      if ((e.key === 'Backspace' || e.key === 'Delete') && isTextEditable(sel)){
        e.preventDefault();
        var delBatch = captureBatch([sel]);
        sel.innerHTML = '';
        var delSt = stateOf(sel);
        delSt.text = '';
        saveState(sel, delSt);
        commitBatch(delBatch);
        positionBox();
        return;
      }
      if (e.key === 'Escape'){ deselect(); return; }
      // Holding an arrow key fires many keydown events — coalesce a whole
      // hold into one undo step the same way the wheel-resize burst does.
      var step = e.shiftKey ? 10 : 1, st = stateOf(sel), moved = true;
      if (e.key === 'ArrowLeft') st.dx -= step; else if (e.key === 'ArrowRight') st.dx += step;
      else if (e.key === 'ArrowUp') st.dy -= step; else if (e.key === 'ArrowDown') st.dy += step;
      else moved = false;
      if (moved){
        e.preventDefault();
        if (!nudgeBatch) nudgeBatch = captureBatch([sel]);
        clearTimeout(nudgeIdleTimer);
        nudgeIdleTimer = setTimeout(function(){ commitBatch(nudgeBatch); nudgeBatch = null; }, 400);
        saveState(sel, st);
        positionBox();
      }
    });
    var nudgeBatch = null, nudgeIdleTimer = null;

    // Live-save while typing (covers the case where a click elsewhere is
    // the very first event caught, so nothing is lost between keystrokes
    // and the eventual exit-save).
    root.addEventListener('input', function(e){
      if (editingEl && e.target === editingEl) saveText(editingEl);
    });

    // ---- align: repair the complete tile system in one undoable action ----
    // A tile's existing CSS/CANVA-BAKED transform lives in __cvBase. Clearing
    // only the editor-authored delta therefore returns every card to exactly
    // the position and size the current theme defines, without disturbing the
    // deliberately reordered baked layout.
    function align(){
      var tiles = els.filter(function(el){ return el.matches('.pdp-cmp__card'); });
      var textTargets = els.filter(function(el){
        return el.__cvAlignH && el.closest('.pdp-cmp__card') && !isAlignExcluded(el);
      });
      var alignXKey = desktopMQ.matches ? 'axd' : 'axm';
      var alignYKey = desktopMQ.matches ? 'ayd' : 'aym';
      var otherAlignXKey = desktopMQ.matches ? 'axm' : 'axd';
      var directTextTargets = textTargets.filter(function(el){
        return el.parentElement && el.parentElement.matches('.pdp-cmp__card') &&
          el.matches('.pdp-cmp__eyebrow, .pdp-cmp__stat, .pdp-cmp__stat-row, .pdp-cmp__sub');
      });
      var batch = captureBatch(tiles.concat(textTargets));
      var changed = {};
      function remember(el){ changed[el.__cvKey] = true; }

      tiles.forEach(function(el){
        var st = stateOf(el);
        if (st.dx !== 0 || st.dy !== 0 || st.s !== 1){
          st.dx = 0; st.dy = 0; st.s = 1;
          saveState(el, st); remember(el);
        }
      });

      // First remove every stored sideways text nudge, including nested stat
      // parts, plus this viewport's previous centering correction. The other
      // viewport's correction stays independent. Vertical placement, scale,
      // and edited wording are preserved.
      textTargets.forEach(function(el){
        var st = stateOf(el);
        if (st.dx !== 0 || st[alignXKey] !== 0 || st[alignYKey] !== 0){
          // dx is shared between viewports. Move its old value into the
          // inactive viewport's private correction before clearing it, so
          // repairing this viewport leaves the other one visually unchanged.
          st[otherAlignXKey] += st.dx;
          st.dx = 0; st[alignXKey] = 0; st[alignYKey] = 0;
          saveState(el, st); remember(el);
        }
      });

      // Authored CSS intentionally places a few text groups off-centre, so a
      // zero dx is not enough. Measure each visible top-level group and move
      // its visual centre onto the card centre through the exact transform
      // inverse. Nested stat parts stay together as one group.
      directTextTargets.forEach(function(el){
        if (!(el.textContent || '').trim()) return;
        var card = el.closest('.pdp-cmp__card');
        var er = el.getBoundingClientRect(), cr = card.getBoundingClientRect();
        if (!er.width || !er.height || !cr.width) return;
        var screenDx = (cr.left + cr.width/2) - (er.left + er.width/2);
        if (Math.abs(screenDx) < 0.25) return;
        var inv = screenDeltaInverse(el);
        if (!inv) return;
        var st = stateOf(el);
        st[alignXKey] += inv.xx * screenDx;
        st[alignYKey] += inv.yx * screenDx;
        saveState(el, st); remember(el);
      });

      commitBatch(batch);
      positionBox();
      return Object.keys(changed).length;
    }

    // ---- export payload for "lock it" ----
    function exportCode(){
      var out = [];
      var activeViewport = desktopMQ.matches ? 'desktop' : 'mobile';
      function round2(n){ return Math.round(n*100)/100; }
      els.forEach(function(el){
        var s = layout[el.__cvKey];
        if (!s) return;
        var st = stateOf(el);
        // Keep the legacy dx/dy fields as the active viewport for existing
        // lock workflows, while retaining both viewport corrections whenever
        // they differ so neither layout is silently lost in the copied JSON.
        var desktopDx = round2(st.dx + st.axd), desktopDy = round2(st.dy + st.ayd);
        var mobileDx = round2(st.dx + st.axm), mobileDy = round2(st.dy + st.aym);
        var dx = desktopMQ.matches ? desktopDx : mobileDx;
        var dy = desktopMQ.matches ? desktopDy : mobileDy;
        var hasTransform = desktopDx || desktopDy || mobileDx || mobileDy || (st.s && st.s !== 1);
        var hasText = st.text != null;
        if (!hasTransform && !hasText) return;
        var item = { sel: '.pdp-cmp>' + el.__cvKey, kind: label(el), dx: dx, dy: dy, s: st.s||1, base: el.__cvBase || 'none' };
        if (desktopDx !== mobileDx || desktopDy !== mobileDy){
          item.viewportOffsets = {
            desktop:{dx:desktopDx,dy:desktopDy},
            mobile:{dx:mobileDx,dy:mobileDy}
          };
        }
        if (hasText) item.text = st.text;
        out.push(item);
      });
      return JSON.stringify({ v:1, viewport:activeViewport, note:'Voltical compare-grid layout — ' + activeViewport, items: out }, null, 2);
    }

    // ---- toolbar ----
    var tb = document.createElement('div');
    tb.className = 'cv-tb' + (showHint ? '' : ' cv-tb--compact');
    var hintText = coarse
      ? 'Tip: tap a tile · double-tap an item · drag to move · pinch or corners resize.'
      : 'Tip: click a tile · double-click an item · drag to move · scroll or corners resize.';
    tb.innerHTML =
      '<span class="cv-tb__dot"></span><span class="cv-tb__title">Canva mode</span>' +
      (showHint ? '<span class="cv-tb__hint">' + hintText + '</span>' : '') +
      '<button class="cv-btn" data-cv="undo" title="Undo the last move, resize, type, delete, Align, or Reset.">Undo</button>' +
      '<button class="cv-btn" data-cv="refresh" title="Reload the page, keeping all your changes and the undo history.">Refresh</button>' +
      '<button class="cv-btn" data-cv="edit-text" title="Type into the selected caption." hidden>Edit text</button>' +
      '<button class="cv-btn" data-cv="align" title="Repair all six tile positions and sizes, and horizontally centre every tile text group. Images and icons stay untouched.">Align all</button>' +
      '<button class="cv-btn" data-cv="reset-sel">Reset one</button>' +
      '<button class="cv-btn" data-cv="reset-all">Reset all</button>' +
      '<button class="cv-btn cv-btn--go" data-cv="copy">Copy layout</button>' +
      '<button class="cv-btn" data-cv="done">Done</button>';
    document.body.appendChild(tb);
    if (showHint){
      ls(false, HINT_KEY, HINT_VERSION);
      cookieSet(HINT_COOKIE, HINT_VERSION);
    }
    editTextBtn = tb.querySelector('[data-cv="edit-text"]');
    updateEditTextButton();

    // ---- export panel ----
    var panel = document.createElement('div'); panel.className = 'cv-panel';
    panel.innerHTML =
      '<div class="cv-panel__card">' +
        '<div class="cv-panel__head"><b>Layout code</b><button class="cv-btn" data-cv="close">Close</button></div>' +
        '<textarea readonly spellcheck="false"></textarea>' +
        '<div class="cv-panel__foot"><span class="cv-panel__note">Copied to your clipboard. Paste this to Claude and say “lock it”.</span>' +
        '<button class="cv-btn cv-btn--go" data-cv="copy2">Copy again</button></div>' +
      '</div>';
    document.body.appendChild(panel);
    var ta = panel.querySelector('textarea');

    function copyToClipboard(text){ try { navigator.clipboard.writeText(text); } catch(e){ try { ta.focus(); ta.select(); document.execCommand('copy'); } catch(_){} } }

    // ---- Reset all two-tap confirmation ----
    var resetAllTimer = null;
    function armResetAll(btn){
      if (btn.dataset.label == null) btn.dataset.label = btn.textContent;
      btn.classList.add('is-armed');
      btn.textContent = 'Sure? Reset all';
      clearTimeout(resetAllTimer);
      resetAllTimer = setTimeout(disarmResetAll, 4000);
    }
    function disarmResetAll(){
      clearTimeout(resetAllTimer);
      var btn = tb.querySelector('[data-cv="reset-all"]');
      if (btn && btn.classList.contains('is-armed')){
        btn.classList.remove('is-armed');
        if (btn.dataset.label != null) btn.textContent = btn.dataset.label;
      }
    }

    tb.addEventListener('click', function(e){
      var b = e.target.closest('[data-cv]'); if (!b) return;
      var a = b.dataset.cv;
      // Any toolbar tap other than Reset all itself cancels a pending
      // Reset-all confirmation.
      if (a !== 'reset-all') disarmResetAll();
      if (a === 'undo'){ undo(); }
      else if (a === 'refresh'){
        // Layout + undo history are already persisted on every change, so a
        // plain reload comes back with everything intact. Commit any caption
        // currently being typed first so it isn't lost on the way out.
        if (editingEl) exitTextEdit();
        location.reload();
      }
      else if (a === 'edit-text' && sel && isTextEditable(sel)){ enterTextEdit(sel); }
      else if (a === 'align'){ align(); }
      else if (a === 'reset-sel' && sel){
        var resetBatch = captureBatch([sel]);
        saveState(sel, {dx:0, dy:0, s:1, text:null});
        commitBatch(resetBatch);
        positionBox();
      }
      else if (a === 'reset-all'){
        // Two-tap "are you sure": the first tap arms the button (turns it
        // red and relabels it); only a second tap within a few seconds
        // actually resets. More reliable than a native confirm() dialog,
        // which some mobile in-app browsers silently suppress.
        if (!b.classList.contains('is-armed')){
          armResetAll(b);
          return;
        }
        disarmResetAll();
        var resetAllBatch = captureBatch(els.filter(function(el){ return layout[el.__cvKey]; }));
        layout = {};
        ls(false, LKEY, JSON.stringify(layout));
        commitBatch(resetAllBatch);
        els.forEach(applyState);
        deselect();
      }
      else if (a === 'copy'){ ta.value = exportCode(); copyToClipboard(ta.value); panel.classList.add('is-open'); }
      else if (a === 'done'){
        rm('volt-canva-on');
        var search = location.search.replace(/([?&])edit=\d+/g, '').replace(/^&/, '?').replace(/^\?$/, '');
        location.href = location.pathname + search + location.hash;
      }
    });
    panel.addEventListener('click', function(e){
      var b = e.target.closest('[data-cv]');
      if (b && b.dataset.cv === 'close'){ panel.classList.remove('is-open'); return; }
      if (b && b.dataset.cv === 'copy2'){ copyToClipboard(ta.value); return; }
      if (e.target === panel) panel.classList.remove('is-open');
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
