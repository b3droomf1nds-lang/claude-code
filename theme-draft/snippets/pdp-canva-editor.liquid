  if (wantOff) rm('volt-canva-on');
  var ON = ls(true, 'volt-canva-on') === '1' && !wantOff;

  var LKEY = 'volt-canva-layout-4';
  // Undo history is persisted alongside the layout so the Refresh button
  // can reload the page without throwing away the undo stack. Reset all
  // wipes both so a fresh start has nothing to undo back into.
  var HKEY = 'volt-canva-history-4';
  // The toolbar tip is shown once per browser. Bump this version only when
  // introducing a real new editor gesture or control, and update its copy
  // below; that gives the new feature one clear first-use introduction.
  var HINT_KEY = 'volt-canva-hint-version';
  var HINT_VERSION = '2';
  var HINT_COOKIE = 'volt-canva-hint-v2';
