  // Keep the flag in the URL so ChatGPT's "Open in browser" handoff carries
  // it into Safari/Chrome. Each browser has separate localStorage, so this
  // marker makes the same URL one-shot independently in each browser.
  var RECOVER_TOP_KEY = 'volt-canva-recovered-top-image-v1';
  var recoverTopImage = recoverTopImageRequested && ls(true, RECOVER_TOP_KEY) !== '1';

