  var layout = {};
  try { layout = JSON.parse(ls(true, LKEY) || '{}') || {}; } catch(e){ layout = {}; }
  // Raw (key-based) undo batches read back from storage; remapped to live
  // elements once they're registered below.
  var savedHistory = [];
  try { savedHistory = JSON.parse(ls(true, HKEY) || '[]') || []; } catch(e){ savedHistory = []; }

  var EDITABLE = '.pdp-cmp__card, .pdp-cmp__img-slot img, .pdp-cmp__eyebrow, ' +
    '.pdp-cmp__stat, .pdp-cmp__stat-row, .pdp-cmp__sub, ' +
    '.pdp-cmp__battery-icon, .pdp-cmp__select-heading, .pdp-cmp__label, .pdp-cmp__select-wrap, ' +
    // The visible "×" on the partial-charges tile ("Up to 3.6× / 20% to
    // 80%") is its own span so it can be grabbed on its own, separate from
    // the number — but its hidden mirror twin (used to balance the
    // centering) is aria-hidden and must stay out of reach.
    '.pdp-cmp__stat-x:not(.pdp-cmp__stat-x--mirror)';

  function start(){
    var root = document.querySelector('.pdp-cmp');
    if (!root) return;

    function pathFor(el){
      var parts = [], cur = el;
      while (cur && cur !== root && cur.parentNode){
        var p = cur.parentNode;
        var idx = Array.prototype.indexOf.call(p.children, cur) + 1;
        parts.unshift(':nth-child(' + idx + ')');
        cur = p;
      }
      return parts.join('>');
    }
    // Only literal captions are safe to type into — the stat numbers
    // (data-calc-*) are computed live by the compare script, so editing
    // them by hand would just get overwritten on the next recalculation.
    // The one deliberate exception is the "full charges" stat
    // ([data-calc-full]) — made typeable on request; typing into it
    // detaches it from the live calculator, so it'll stop updating when
    // the iPhone-model dropdown changes and just show whatever was typed.
    function isTextEditable(el){
      return el.matches('.pdp-cmp__eyebrow, .pdp-cmp__sub, .pdp-cmp__select-heading, .pdp-cmp__label, [data-calc-full]');
    }
    function isChargeRangeCaption(el){
      return el.matches('.pdp-cmp__sub--range');
    }
    // Wider than isTextEditable: also covers the big live-computed stat
    // numbers (e.g. "67h"), which must NOT be made typeable (they're
    // overwritten by the compare script on recalculation) but still
    // deserve the same "Align only ever straightens left/right, never
    // moves vertically" treatment as a caption.
    function isAlignHoriz(el){
      return isTextEditable(el) || el.matches('.pdp-cmp__stat, .pdp-cmp__stat-row, .pdp-cmp__stat-x');
    }
    // The charge-time number and its battery form one deliberately composed
    // visual. Align all must leave that pair exactly where the editor placed it.
    function isAlignExcluded(el){
      return !!el.closest('.pdp-cmp__card--charge') &&
        el.matches('.pdp-cmp__stat, .pdp-cmp__stat-row');
    }

    var editingEl = null;

    function stateOf(el){
      var s = layout[el.__cvKey];
      return s ? {
        dx:s.dx||0, dy:s.dy||0, s:s.s||1,
        axd:s.axd||0, ayd:s.ayd||0, axm:s.axm||0, aym:s.aym||0,
        text:(s.text!=null ? s.text : null)
      } : {dx:0,dy:0,s:1,axd:0,ayd:0,axm:0,aym:0,text:null};
    }

    // ---- carry canonical editor moves onto whatever viewport is showing ----
    // dx/dy stay stored in the editor's established DESKTOP local-pixel
    // coordinate system (including when a phone authors the move), because
    // that is what existing saved layouts and the lock/export workflow use —
    // where a tile's untransformed box is DESK_REF_W wide. Mobile lays the
    // same tile out at its full column width (no scale transform), so a raw
    // desktop offset would land a caption/image in completely the wrong spot.
    // Since dx/tileWidth is the move as a fraction of its tile — and that
    // fraction is exactly what should look identical on both — we re-express
    // the offset for the current viewport as dx * (thisTileWidth / DESK_REF_W).
    // offsetWidth ignores transforms, so this measures true local box widths
    // and self-corrects to any phone width, not just one hard-coded size.
    // scale(s) is a unitless ratio and needs no conversion; the element's own
    // base transform is read per-viewport already, so it's right on each.
    var desktopMQ = window.matchMedia('(min-width:900px)');
    // Desktop's tile box width is fixed regardless of window size (its scale
    // transform does the sizing), so measure it once on desktop and cache it;
    // on a phone (no editor, only a restored layout) fall back to the cached
    // value, or the known baked default if this browser never saw desktop.
    var REFKEY = 'volt-canva-refw';
    var DESK_REF_W = (function(){
      if (desktopMQ.matches){
        var t = document.querySelector('.pdp-cmp__card');
        if (t && t.offsetWidth){ ls(false, REFKEY, String(t.offsetWidth)); return t.offsetWidth; }
      }
      var cached = parseFloat(ls(true, REFKEY));
      return cached > 0 ? cached : 107;
    })();
    function translateFactor(el){
      if (desktopMQ.matches) return 1; // desktop-authored state is already local
      // A whole tile moved onto a different desktop grid cell has no meaning
      // in mobile's single-column stack (that reordering is handled in CSS),
      // so don't fling the tile across the screen — only its contents move.
      if (el.matches('.pdp-cmp__card')) return 0;
      var tile = el.closest('.pdp-cmp__card');
      if (!tile || !tile.offsetWidth || !DESK_REF_W) return 1;
      return tile.offsetWidth / DESK_REF_W;
    }
    function effTranslate(el, st){
      var f = translateFactor(el);
      // Align's horizontal correction is viewport-specific. The compare CSS
      // deliberately gives a few captions different desktop/mobile bases
      // (notably the tall phone cards), so sharing one correction would make
      // Align on a phone move that caption off-centre on desktop, or vice
      // versa. Ordinary hand-authored movement remains shared/canonical.
      var ax = desktopMQ.matches ? st.axd : st.axm;
      var ay = desktopMQ.matches ? st.ayd : st.aym;
      return {dx: (st.dx + ax) * f, dy: (st.dy + ay) * f};
    }

    // Canva mode restores caption innerHTML from localStorage, so markup added
    // only in Liquid can disappear on refresh. Rebuild the emphasis from the
    // visible text every time. Walking text nodes (instead of regexing the raw
    // HTML) also handles saved <br>, &nbsp;, or nested spans inside the phrase.
    function decorateChargeRangeText(html){
      var box = document.createElement('div');
      box.innerHTML = html;

      // Remove any older/partial wrappers first. This makes the operation
      // deterministic: every saved version is rebuilt from its visible text,
      // so a stale span around only "20%" cannot survive forever.
      [].slice.call(box.querySelectorAll('.pdp-cmp__charge-range-lead, .pdp-cmp__range-bold')).forEach(function(span){
        var parent = span.parentNode;
        while (span.firstChild) parent.insertBefore(span.firstChild, span);
        parent.removeChild(span);
      });

      // The charge caption used to be saved as either just the range or
      // "Charging time from" plus the range. Migrate those old defaults to
      // the current desktop/mobile copy while keeping only the range itself
      // emphasized in each composition.
      var visibleBefore = (box.textContent || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
      if (/^(?:Charging time from\s+)?20%\s+to\s+80%(?:\s+with Core(?:\s+for quick, (?:dependable|reliable) everyday power)?)?$/i.test(visibleBefore)){
        // Deliberately insert plain phrase text here. The common range walker
        // below then creates exactly one fresh lead span in each copy, rather
        // than nesting a new wrapper inside a migration wrapper.
        box.innerHTML = '<span class="pdp-cmp__desktop-copy">Charging time from 20% to 80% with Core for quick, reliable everyday power<br></span><span class="pdp-cmp__mobile-copy">Quick, reliable charging<br>from 20% to 80% with Core.<br></span>';
      }

      var flat = '', pieces = [];
      function collect(node){
        if (node.nodeType === 3){
          var value = node.nodeValue || '';
          pieces.push({node:node, start:flat.length, end:flat.length + value.length});
          flat += value;
          return;
        }
        if (node.nodeType !== 1) return;
        if (node.tagName === 'BR') { flat += ' '; return; }
        [].slice.call(node.childNodes).forEach(collect);
      }
      [].slice.call(box.childNodes).forEach(collect);

      var matches = [], rangeRe = /20%[\s\u00a0]+to[\s\u00a0]+80%/ig, match;
      while ((match = rangeRe.exec(flat))) matches.push({from:match.index, to:match.index + match[0].length});
      if (!matches.length) return box.innerHTML;

      // Work backwards so splitting a later text node cannot disturb offsets
      // recorded for an earlier one. Desktop and mobile can each contain the
      // same phrase, so rebuild every visible occurrence—not only the first.
      matches.slice().reverse().forEach(function(range){
        pieces.slice().reverse().forEach(function(piece){
          var start = Math.max(range.from, piece.start);
          var end = Math.min(range.to, piece.end);
          if (start >= end) return;
          var target = piece.node;
          var localStart = start - piece.start;
          var localLength = end - start;
          if (localStart) target = target.splitText(localStart);
          if (localLength < target.nodeValue.length) target.splitText(localLength);
          var span = document.createElement('span');
          span.className = 'pdp-cmp__charge-range-lead';
          target.parentNode.insertBefore(span, target);
          span.appendChild(target);
        });
      });
