{%- comment -%}
  Canva-style live layout editor for the compare tile section.

  It turns the "See how Core upgrades your experience" block into a
  drag-and-drop canvas: click any tile / image / text / icon to select
  it, drag to move it, and drag a corner (or scroll the wheel) to make
  it bigger or smaller — just like moving elements around a Canva page.

  HOW IT TURNS ON
    Add ?edit=1 to the product-page URL in the theme preview. That flips
    the section into edit mode AND remembers it (so it stays on across
    reloads while you fine-tune). Add ?edit=0 (or hit "Done") to leave.
    Normal visitors never see any of this — with no flag, the script only
    re-applies a saved layout and adds zero controls.

  HOW "LOCK IT" WORKS
    Your moves are saved live in the browser (localStorage) so nothing is
    lost on reload and the preview always shows your work-in-progress.
    When it's positioned how you want, click "Copy layout" (or just tell
    Claude "lock it") and hand Claude the copied code — Claude bakes those
    exact positions/sizes permanently into the matching desktop/mobile CSS
    and clears the temporary browser copy.

  The same controls work on desktop and phone. Desktop keeps its mouse,
  wheel, keyboard, and compact handles; phone adds tap/double-tap,
  one-finger move, pinch resize, and larger touch handles.

  ALIGN
    Click "Align" to repair the WHOLE section, regardless of what is
    selected. Every tile returns to its normal size and the exact
    authored position it has now, on both desktop and phone.

    Every visible text group inside every tile is centered horizontally
    while keeping its vertical position, size, and wording. Images and
    standalone icons are left exactly where you put them. The entire
    repair is one Undo step. Phone and desktop centering corrections are
    kept separate, so aligning one layout cannot knock the other off-centre.

  EDITING TEXT
    Double-click a caption/heading (not the live numbers, which are
    computed by JS) to drill into it — same as any image or icon, and
    still draggable with a single click-hold from there. Once it's
    selected, either press Enter or just click it again (a plain click
    that doesn't turn into a drag) to start typing into it, in its own
    font; the cursor lands at the end of the existing text so you can
    add more. Press Enter again to start a new line lower in the same
    box. Click anywhere else (or press Escape) to stop typing; the
    edit is saved live like everything else and included in "Copy
    layout".

    Click-to-type only fires on a SECOND click, once the text is
    already selected — the double-click that first drills into/selects
    it always just selects, so it's still possible to double-click and
    immediately drag without getting hijacked into typing.

    On phone, double-tapping text also only selects it, so it can be
    dragged immediately like an image. A contextual "Edit text" button
    appears in the toolbar for a selected editable caption; tap that
    button to open the keyboard. Taps inside active text editing keep
    their normal caret-placement behaviour.

    With a text box selected (not currently being typed into), press
    Backspace or Delete to clear it out.

  UNDO
    Click "Undo" in the toolbar to step back one action at a time —
    a move, a resize, typing/deleting a caption, or a whole Align /
    Reset click. Holding an arrow key or scrolling to resize counts as
    ONE action (the whole hold/scroll), not one per tick.
{%- endcomment -%}
<style>
  .cv-tb{position:fixed;top:14px;left:14px;z-index:2147483000;display:flex;gap:6px;align-items:center;
    background:#111;color:#fff;border:1px solid #2c2c2c;border-radius:12px;padding:8px 10px;
    font:13px/1.2 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    box-shadow:0 8px 30px rgba(0,0,0,.35);user-select:none;}
  .cv-tb__dot{width:8px;height:8px;border-radius:50%;background:#16c76a;box-shadow:0 0 8px #16c76a;flex:none;}
  .cv-tb__title{font-weight:600;letter-spacing:.02em;margin-right:4px;}
  .cv-tb__hint{opacity:.55;font-size:11px;max-width:280px;line-height:1.35;}
  .cv-btn{appearance:none;border:1px solid #333;background:#1d1d1f;color:#fff;border-radius:8px;
    padding:6px 10px;font:inherit;font-size:12px;cursor:pointer;white-space:nowrap;}
  .cv-btn:hover{background:#2a2a2c;}
  .cv-btn--go{background:#0a84ff;border-color:#0a84ff;}
  .cv-btn--go:hover{background:#0a74e0;}
  /* Armed "are you sure" state for Reset all (a reliable two-tap confirm
     that works even where a native confirm() dialog is suppressed). */
  .cv-btn.is-armed{background:#c0392b;border-color:#c0392b;}
  .cv-btn.is-armed:hover{background:#a93226;}

  .cv-hover{outline:1.5px dashed rgba(10,132,255,.55) !important;outline-offset:1px;cursor:grab;}
  /* The image wrappers are normally pointer-events:none (they're decorative,
     aria-hidden) so clicks pass through to the tile behind them. While
     editing, re-enable pointer events on them so the image itself is
     clickable/double-clickable like everything else. */
  .cv-editing .pdp-cmp__img-slot,
  .cv-editing .pdp-cmp__img-slot img{pointer-events:auto !important;}
  /* Kill the browser's OWN pinch-zoom and double-tap-zoom document-wide
     while editing — without this, a two-finger pinch (meant to resize the
     selected element) and a double-tap (meant to drill into it) both also
     trigger the browser's native page-zoom at the same time, and once that
     kicks in its own momentum/rubber-band settling and can make an image
     look like it "flies off" after release. pan-y keeps one-finger page
     scroll working everywhere; it only removes zoom gestures. Put it on
     both roots because iOS and Chromium do not always choose the same one
     as the document's gesture owner. */
  html.cv-editing,
  html.cv-editing body{touch-action:pan-y;}
  /* The whole compare block lives inside [data-reveal], whose global image
     rule eases transform for a full second. That is desirable for the
     storefront reveal, but disastrous for an editor: each new drag sample
     retargets the transition, so an image trails the finger and keeps
     moving after release. Editing must always render transforms exactly. */
  .cv-editing .pdp-cmp,
  .cv-editing .pdp-cmp *{transition:none !important;}
  /* Pre-warm only the one selected phone element, then suppress selection /
     callouts while its gesture is active. Promoting every tile permanently
     costs a surprising amount of phone memory. */
  .cv-touch-ready,
  .cv-touch-active{will-change:transform;}
  .cv-touch-active{-webkit-touch-callout:none;user-select:none;}
  .cv-box{position:fixed;z-index:2147482000;border:1.5px solid #0a84ff;pointer-events:none;
    box-shadow:0 0 0 1px rgba(255,255,255,.6);}
  .cv-h{position:absolute;width:12px;height:12px;background:#fff;border:1.5px solid #0a84ff;
    border-radius:50%;pointer-events:auto;touch-action:none;box-shadow:0 1px 3px rgba(0,0,0,.3);}
  .cv-h--tl{top:-7px;left:-7px;cursor:nwse-resize;}
  .cv-h--tr{top:-7px;right:-7px;cursor:nesw-resize;}
  .cv-h--bl{bottom:-7px;left:-7px;cursor:nesw-resize;}
  .cv-h--br{bottom:-7px;right:-7px;cursor:nwse-resize;}
  .cv-tag{position:absolute;top:-22px;left:-1px;background:#0a84ff;color:#fff;font:11px/1 -apple-system,
    BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;padding:3px 6px;border-radius:5px;white-space:nowrap;
    pointer-events:none;}
  .cv-editing-text{outline:2px solid #0a84ff !important;outline-offset:2px;cursor:text !important;
    /* Keep the caption's natural wrapping visible while it is being edited.
       Explicit Enter-created <br> breaks still work normally. */
    white-space:normal !important;}

  .cv-panel{position:fixed;inset:0;z-index:2147483100;background:rgba(0,0,0,.55);display:none;
    align-items:center;justify-content:center;padding:24px;}
  .cv-panel.is-open{display:flex;}
  .cv-panel__card{background:#161617;color:#fff;border:1px solid #2c2c2c;border-radius:14px;
    width:min(640px,100%);max-height:80vh;display:flex;flex-direction:column;overflow:hidden;
    font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;box-shadow:0 20px 60px rgba(0,0,0,.5);}
  .cv-panel__head{padding:14px 16px;border-bottom:1px solid #262628;display:flex;justify-content:space-between;align-items:center;}
  .cv-panel__head b{font-size:14px;}
  .cv-panel textarea{width:100%;flex:1;min-height:220px;border:0;background:#0d0d0e;color:#d6d6d8;
    font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;padding:14px 16px;resize:none;box-sizing:border-box;}
  .cv-panel__foot{padding:12px 16px;border-top:1px solid #262628;display:flex;gap:8px;justify-content:flex-end;align-items:center;}
  .cv-panel__note{margin-right:auto;opacity:.6;font-size:11px;max-width:340px;}

  /* ---- phone: dock the toolbar to the bottom, let it wrap, and make the
     corner resize handles finger-sized (the 12px desktop dots are too
     small to grab with a fingertip). Kept to coarse pointers so a
     touchscreen laptop with a mouse still gets the compact desktop UI. */
  @media (max-width:899px) and (pointer:coarse){
    html.cv-editing,
    html.cv-editing body{overscroll-behavior-y:none;}
    .cv-tb{top:auto;bottom:calc(10px + env(safe-area-inset-bottom));left:8px;right:8px;
      flex-wrap:wrap;justify-content:center;padding:10px;gap:8px;}
    /* The toolbar always stays bottom-docked. Once its one-time tip has
       been seen, this smaller version simply takes up less vertical space
       above that same fixed bottom edge. */
    .cv-tb.cv-tb--compact{padding:8px;gap:7px;}
    .cv-tb__title{margin-right:0;}
    .cv-tb__hint{flex-basis:100%;max-width:none;text-align:center;order:9;font-size:11px;}
    .cv-btn{padding:10px 13px;font-size:13px;}
    .cv-tb.cv-tb--compact .cv-btn{padding:9px 12px;}
    .cv-h{width:22px;height:22px;}
    .cv-h--tl{top:-12px;left:-12px;} .cv-h--tr{top:-12px;right:-12px;}
    .cv-h--bl{bottom:-12px;left:-12px;} .cv-h--br{bottom:-12px;right:-12px;}
    .cv-tag{top:-24px;font-size:12px;padding:4px 7px;}
  }
</style>
<script>
(function(){
  if (window.__cvCanvaInit) return;
  window.__cvCanvaInit = true;

  var qs = location.search || '';
  var wantOn  = /[?&]edit=1(?:&|$)/.test(qs);
  var wantOff = /[?&]edit=0(?:&|$)/.test(qs);
  // A URL-triggered full wipe of the saved layout, for when a touch-drag
  // has left something stranded off-screen and the on-page "Reset all"
  // button isn't reachable (e.g. the broken element is covering it, or the
  // page never got scrolled far enough to reach the toolbar reliably).
  var wantResetAll = /[?&]resetall=1(?:&|$)/.test(qs);
  // One-shot recovery link for an image accidentally dragged out of reach.
  // It only clears the top tile image's move offset; its chosen zoom and the
  // rest of the saved layout stay exactly as they were.
  var recoverTopImageRequested = /[?&]recover=top-image(?:&|$)/.test(qs);
  function ls(get, k, v){ try { return get ? localStorage.getItem(k) : localStorage.setItem(k, v); } catch(e){ return null; } }
  function rm(k){ try { localStorage.removeItem(k); } catch(e){} }
  // Some in-app mobile browsers temporarily deny localStorage to preview
  // pages. The onboarding flag is harmless but should still survive a
  // reload there, so mirror just that flag in a first-party cookie.
  function cookieGet(k){
    var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + k.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\$&') + '=([^;]*)'));
