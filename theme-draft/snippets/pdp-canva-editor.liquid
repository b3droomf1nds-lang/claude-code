        // that would reset the cursor mid-keystroke. Otherwise it should
        // always show whatever's saved, OR its original text if nothing
        // is — that "OR" matters for undo: undoing a delete (or a typed
        // edit) clears the saved text, and the box needs to actively come
        // back to its original content, not just sit however it was left.
        var wantText = st.text != null ? st.text : el.__cvOrigText;
        if (isChargeRangeCaption(el)) wantText = decorateChargeRangeText(wantText);
        if (el !== editingEl && el.innerHTML !== wantText){
          el.innerHTML = wantText;
        }
        // The charge caption is intentionally multi-line in both Canva and
        // the finished preview. Override its authored nowrap so saved text
        // cannot collapse back into one line after editing ends. Preserve
        // the existing behavior for every other editable box.
        el.style.whiteSpace = isChargeRangeCaption(el)
          ? 'normal'
          : (st.text != null ? 'nowrap' : '');
      }
