{%- assign _ref = section.settings.product -%}
{%- unless _ref.handle -%}{%- assign _ref = all_products[_ref] -%}{%- endunless -%}
<style>
  .apple-hero{
    position:relative;
    height:calc(66.67vh + 240px);
    height:calc(66.67lvh + 240px);
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    background:var(--base);
    z-index:0;
    overflow:hidden;
  }
  .apple-hero__head{padding:clamp(72px,10vw,116px) 0 clamp(28px,4vw,48px);flex-shrink:0}
  .apple-hero__eyebrow{
    font-family:var(--sans);
    font-weight:700;
    font-size:clamp(2.2rem,4.2vw,3.6rem);
    line-height:1.05;
    margin:0 0 22px;
    transform:translateY(65px);
  }
  .apple-hero__subhead{
    font-size:clamp(1rem,1.4vw,1.2rem);
    color:var(--ink-60);
    max-width:560px;
    margin:0 auto 38px;
    transform:translateY(73px);
  }
  .apple-hero__ctas{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    justify-content:center;
    transform:translateY(69px);
  }
  .apple-hero__media{
    flex:1 1 0;
    width:100%;
    min-height:0;
    overflow:hidden;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    padding:0 clamp(16px,4vw,48px) 0;
  }
  .apple-hero__media img{
    max-width:100%;
    max-height:100%;
    width:auto;
    height:auto;
    object-fit:contain;
    display:block;
    transform:scale(1.229);
  }
  @media (max-width:640px){
    .apple-hero{ height:calc(66.67lvh + 120px); }
    .apple-hero__head{ padding-top:94px; padding-bottom:18px; }
    .apple-hero__eyebrow{ transform:translateY(34px); }
    .apple-hero__subhead{ transform:translateY(42px); margin-bottom:26px; max-width:310px; line-height:1.35; }
    .apple-hero__ctas{ transform:translateY(40px); }
    .apple-hero__ctas .btn{ padding:9px 18px; font-size:.475rem; gap:5px; }
    /* pushed down with padding (not a flex-item margin) and clipped by the
       section's own overflow:hidden above, so the image can never render
       outside the hero's box no matter how the page scrolls — the grid
       below has 0 margin-top, so the two boxes can't geometrically meet. */
    .apple-hero__media{ align-items:flex-start; padding-top:93px; overflow:hidden; }
    .apple-hero__media img{ transform:scale(2.02) translateY(8px); }
  }
  .apple-hero__media img{
  }
</style>
<section class="apple-hero">
  <div class="wrap wrap--wide apple-hero__head" data-reveal>
    <h2 class="apple-hero__eyebrow">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="apple-hero__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="apple-hero__ctas">
      {%- if section.settings.cta_primary != blank -%}
        <a class="btn btn--accent" href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_primary }}</a>
      {%- endif -%}
      {%- if section.settings.cta_secondary != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.cta_secondary_link | default: _ref.url | default: routes.all_products_collection_url }}">{{ section.settings.cta_secondary }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="apple-hero__media">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 3840 }}"
           alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
           srcset="{{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2600 }} 2600w, {{ section.settings.image | image_url: width: 3840 }} 3840w"
           sizes="100vw" loading="eager">
    {%- elsif _ref.featured_image -%}
      <img src="{{ _ref.featured_image | image_url: width: 2400 }}" alt="{{ _ref.title | escape }}" loading="eager">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Apple-style hero banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Brand / heading", "default": "Voltical" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Magnetic charging, finished like it came in the box." },
    { "type": "text", "id": "cta_primary", "label": "Primary CTA label", "default": "Learn more" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary CTA label", "default": "Shop the lineup" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary CTA link" },
    { "type": "product", "id": "product", "label": "Fallback product (image + link)" },
    { "type": "image_picker", "id": "image", "label": "Banner image" }
  ],
  "presets": [{ "name": "Apple-style hero banner" }]
}
{% endschema %}
