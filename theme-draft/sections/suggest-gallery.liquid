{%- comment -%}
  Suggested products as a swipeable gallery, after Apple's "Get the
  highlights" gallery (apple.com/iphone-18-pro). The cards are Apple's size
  on a phone (87.5vw - 20px wide, 480px tall, 28px corners, 20px apart, the
  next one peeking) and each looks like the "Pair with the USB-C Cable" tile:
  heading and grey caption at the top, the product photo filling the card.
  The photos are 2:3 like the cards, with empty white above the product, so
  the text sits there. At the bottom, as on the Apple Store's product cards:
  a small label (Apple's "New") and the product's name, then a bar in the
  bubbles' frost (below) with a line of grey on the left and a small Add
  pill on the right (straight into the bag, without opening it; "Add to
  bag" to a screen reader). The photo fades to the card's white above the
  name, as Apple's fade to black.

  The small line under the heading is the current card's own (its "small
  line", or the subheading if it has none); it rolls up to the next card's,
  or down to the one before's, as the dots change. When all the cards show
  at once it's the subheading. "Hide the small line" takes it away and
  moves the heading down into its place.

  Swipe the cards, or use the two frosted bubbles that rise and unfold near
  the bottom of the screen while the gallery is on screen: the dots (grey,
  the current card's a grey line, as on Apple's) and the arrows (the dots'
  grey, no press highlight). The cards themselves have no corner arrow; a
  tap anywhere on a card, off its Add, opens the product. The bubbles stick
  12px above the bottom of the page's view, the same whether or not the
  browser's bottom toolbar is showing (no extra for the home indicator),
  until the gap above them, up to the cards, is as big as the one below
  them; then both gaps grow together until they're the 32px the bubbles
  rest under the cards, and from there the bubbles move with the cards. The
  rise and unfold are Apple's own: the springs and timings of its gallery
  controls, read from its page script. The frost is the cart sheet's (its
  tint over the page's dim, blur 6px, saturation 180%) without the sheet's
  bright edge.

  Aim assist near the spot where the heading, the cards and the resting
  controls all fit on screen: scrolling slows down as the page nears it,
  and a flick that would stop near it brakes onto it.
{%- endcomment -%}
<style>
  .sugg{
    --pad:max(6.25vw,env(safe-area-inset-left));  /* Apple's gallery margin */
    --gap:20px;
    --cw:calc(87.5vw - 20px);                       /* Apple's card: 321 x 480 on a 390 phone */
    --ch:480px;
    /* the photo sits 15px lower than it would resting on the card's bottom
       (--img-y), so the space between the caption and the product is half as
       big again, plus the card's own "lower the photo by" (--img-drop) for a
       photo whose product starts higher up; what runs past the bottom is
       cropped */
    --img-y:max(0px,calc(var(--ch) - var(--cw) * 1.5));
    color:var(--ink); padding:clamp(48px,7vw,96px) 0 0;
  }
  .sugg__head{ text-align:center; max-width:640px; margin:0 auto clamp(28px,4vw,48px); }
  .sugg__heading{
    font-family:var(--sans); font-weight:600; letter-spacing:-0.03em;
    font-size:clamp(1.7rem,3vw,2.4rem); line-height:1.1; margin:0 0 12px;
  }
  .sugg__sub{ color:var(--ink-60); font-size:clamp(.95rem,1.2vw,1.05rem); margin:0; }
  /* a line per card, all in one place so the height never changes, the
     current card's showing: the ones before it wait above and the ones
     after below, so it rolls up to the next card's and down to the one
     before's */
  .sugg__sub--lines{ display:grid; overflow:hidden; }
  .sugg__line{ grid-area:1 / 1; opacity:0; transform:translateY(100%); transition:transform .5s var(--ease), opacity .35s ease; }
  .sugg__line.is-up{ transform:translateY(-100%); }
  .sugg__line.is-on{ opacity:1; transform:none; }
  .sugg__sub--lines.is-instant .sugg__line{ transition:none; }
  /* "Hide the small line": the heading moves down into its place (a blank
     line of its size goes above the heading instead), so the cards stay
     where they are */
  .sugg__sub.sugg__room{ margin:0 0 12px; }

  /* the controls rest 32px under the cards, in the gallery's own room */
  .sugg__gallery{ position:relative; padding-bottom:88px; }
  /* room above and below inside the scroller for the cards' shadows */
  .sugg__track{
    position:relative; display:flex; gap:var(--gap);
    overflow-x:auto; overflow-y:hidden; overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory; scroll-padding-inline:var(--pad);
    scrollbar-width:none; -webkit-overflow-scrolling:touch;
    padding:24px 0 44px; margin:-24px 0 -44px;
  }
  .sugg__track::-webkit-scrollbar{ display:none; }
  /* the margins before the first card and after the last (padding at the
     end of a scroller isn't kept everywhere) */
  .sugg__track::before,.sugg__track::after{ content:""; flex:0 0 max(0px,calc(var(--pad) - var(--gap))); }

  .sugg__card{
    position:relative; display:block; flex:0 0 var(--cw); height:var(--ch);
    scroll-snap-align:start; border-radius:28px; overflow:hidden; isolation:isolate;
    background:#fdfeff;  /* the product photos' own white */
    box-shadow:0 1px 2px rgba(19,19,22,.04),0 18px 44px -22px rgba(19,19,22,.14);
    color:inherit; text-decoration:none; -webkit-tap-highlight-color:transparent;
  }
  .sugg__img{
    position:absolute; left:0; top:calc(var(--img-y) + 15px + var(--img-drop,0px)); width:100%; height:auto;
  }
  /* the tile's type: 1.05rem semibold heading, grey caption */
  .sugg__text{ position:relative; padding:32px 32px 0; text-align:center; }
  .sugg__card-heading{
    font-family:var(--sans); font-weight:600; font-size:1.05rem; line-height:1.25;
    letter-spacing:-0.02em; margin:0; color:var(--ink); text-wrap:balance;
  }
  .sugg__card-sub{ font-size:14px; line-height:1.35; color:var(--ink-60); margin:6px 0 0; text-wrap:balance; }
  /* "Hide the heading and caption at the top": just the photos (the text
     at the bottom, the photo's alt and the bar's buttons still name the
     product). The photo's white above the product isn't needed then, so a
     card with text at the bottom has its photo moved up to make room. */
  .sugg--bare .sugg__text{ visibility:hidden; }
  .sugg--bare .sugg__card--info .sugg__img{ transform:translateY(-14%); }

  /* ---- the foot of a card: Apple's product card text, then the bar ---- */
  /* the photo fades to the card's white over the 120px above the name,
     eased at both ends (smoothstep) so the fade has no edge; its corners
     are the card's own (the bar's too), in case the card's clip misses the
     frost's layer */
  .sugg__foot{
    position:absolute; left:0; right:0; bottom:0; display:flex; flex-direction:column;
    background:#fdfeff; border-bottom-left-radius:inherit; border-bottom-right-radius:inherit;
  }
  .sugg__foot::before{
    content:""; position:absolute; left:0; right:0; bottom:100%; height:120px; pointer-events:none;
    background:linear-gradient(rgba(253,254,255,0), rgba(253,254,255,.04) 15px, rgba(253,254,255,.16) 30px, rgba(253,254,255,.32) 45px,
      rgba(253,254,255,.5) 60px, rgba(253,254,255,.68) 75px, rgba(253,254,255,.84) 90px, rgba(253,254,255,.96) 105px, #fdfeff 120px);
  }
  /* Apple's type: its small label and bold name in ink, 24px in from the
     card's sides */
  .sugg__info{ padding:0 24px 16px; }
  .sugg__info:last-child{ padding-bottom:28px; }
  .sugg__label{ font:600 16px/1.25 var(--sans); letter-spacing:-.01em; margin:0 0 2px; color:var(--ink); }
  .sugg__title{
    font-family:var(--sans); font-weight:700; font-size:26px; line-height:1.15;
    letter-spacing:-.03em; margin:0; color:var(--ink); text-wrap:balance;
  }
  /* the bar: in the bubbles' frost (their tint and blur once open), as tall
     as Apple's, the line of grey on the left where Apple has its price and
     the Add pill on the right; a tap on it, off the pill, goes through to
     the card. Only the card's own white is ever behind it, so the frost
     (rgba(239,239,242,.77) over white blurred and saturated 180%) is this
     one solid colour: drawn solid, it costs nothing to scroll, and nothing
     to copy into the cart sheet's glass edge. */
  .sugg__buy{
    position:relative; z-index:2; flex:none; height:80px; pointer-events:none;
    display:flex; align-items:center; gap:12px; padding:0 24px;
    border-bottom-left-radius:inherit; border-bottom-right-radius:inherit;
    background:rgb(243,243,245);
  }
  /* the rest of the card, text included, opens the product, as the whole
     card used to; it's the card's link for keyboards and screen readers too */
  .sugg__hit{ position:absolute; inset:0; z-index:1; border-radius:inherit; -webkit-tap-highlight-color:transparent; }
  .sugg__hit:focus-visible{ outline:2px solid var(--focus,#0071e3); outline-offset:-2px; }
  /* the page's grey a shade darker, for the frost behind it */
  .sugg__desc{ flex:1 1 auto; min-width:0; font:500 14px/1.3 var(--sans); letter-spacing:-.005em; color:rgba(19,19,22,.66); margin:0; text-wrap:pretty; }
  .sugg__add{ display:flex; margin:0 0 0 auto; pointer-events:auto; }
  /* a small pill: 30px tall, 14px either side of a 15px semibold label */
  .sugg__btn{
    position:relative; flex:none; display:flex; align-items:center; justify-content:center; height:30px; padding:0 14px;
    border:0; border-radius:15px; font:600 15px/1 var(--sans); letter-spacing:-.01em; white-space:nowrap;
    text-decoration:none; cursor:pointer; -webkit-tap-highlight-color:transparent;
    transition:transform .2s var(--ease), background-color .25s, opacity .25s;
  }
  .sugg__btn::after{ content:""; position:absolute; inset:-7px -8px; }   /* 44px tall to a finger */
  .sugg__btn:active{ transform:scale(.96); }
  /* black like the page's own Add to bag, which also stays black once added */
  .sugg__btn--add{ background:var(--ink); color:var(--base); }
  .sugg__btn--add.is-adding{ opacity:.6; }
  .sugg__btn--add:disabled{ opacity:.45; cursor:default; }
  @media (hover:hover){
    .sugg__btn--add:hover:not(:disabled){ background:#000; }
  }

  /* ---- the frosted controls ---- */
  /* the controls rise out of a line 24px under their resting place (Apple
     clips its controls the same way), so they never show over the section
     below; the 24px leaves room for the springs' overshoot */
  .sugg__aapbox{
    position:absolute; inset:0 0 -24px; z-index:2; pointer-events:none; overflow:clip;
    display:flex; flex-direction:column; justify-content:flex-end; align-items:center;
  }
  .sugg__aap{
    position:sticky; display:flex; align-items:center; gap:16px; margin-bottom:24px; pointer-events:none;
    bottom:calc(var(--sugg-bar,0px) + 12px);
    transition:bottom .35s cubic-bezier(.25,.8,.25,1);
  }
  .sugg.is-static .sugg__aapbox{ display:none; }
  /* the drop the bubbles grow out of, in the frost's colour, solid */
  .sugg__drop{
    position:absolute; left:50%; top:0; width:56px; height:56px; border-radius:56px;
    background:rgb(239,239,242); opacity:0; transform:translateX(-50%) scale(.01); pointer-events:none;
  }
  .sugg__bubble{
    --alpha:1; position:relative; z-index:1; display:flex; align-items:center; justify-content:center;
    height:56px; border-radius:28px; opacity:0; pointer-events:none;
  }
  /* solid at first, frosted once open: the tint thins from 100% to 77% and
     the blur halves, as Apple's do */
  .sugg__bg{
    --scale:1; position:absolute; left:50%; top:50%; z-index:-1; width:56px; height:56px; border-radius:28px;
    transform:translate(-50%,-50%) scale(var(--scale)); opacity:0;
    background:rgba(239,239,242,calc(1 - var(--alpha) * .23));
  }
  .sugg__aap.is-on .sugg__bubble{ opacity:1; pointer-events:auto; }
  /* frosted only while showing: no blur kept running for hidden bubbles */
  .sugg__aap.is-on .sugg__bg{
    opacity:1;
    -webkit-backdrop-filter:blur(calc(6px * (2 - var(--alpha)))) saturate(180%);
    backdrop-filter:blur(calc(6px * (2 - var(--alpha)))) saturate(180%);
  }
  /* in the cart sheet's copies of the page (its glass edge) the bubbles
     keep their tint but not a blur of their own: the edge blurs the copies
     anyway, and ten copies each blurring live made the sheet lag here */
  :host .sugg__aap.is-on .sugg__bg{ -webkit-backdrop-filter:none; backdrop-filter:none; }

  .sugg__dots{ display:flex; padding:0 16px; }
  /* the current dot stretches into a 32px line, as Apple's does; it grows
     as the old one shrinks, so the bubble's width never changes */
  .sugg__dot{ display:flex; align-items:center; justify-content:center; width:24px; height:56px; opacity:0; -webkit-tap-highlight-color:transparent; transition:width .4s cubic-bezier(.4,0,.2,1); }
  .sugg__dot::before{ content:""; flex:none; width:8px; height:8px; border-radius:4px; background:rgba(0,0,0,.42); transition:width .4s cubic-bezier(.4,0,.2,1); }
  .sugg__dot[aria-current="true"]{ width:48px; }
  .sugg__dot[aria-current="true"]::before{ width:32px; }
  .sugg__aap.is-on .sugg__dot{ opacity:1; transition:opacity .1s ease-in .74s,width .4s cubic-bezier(.4,0,.2,1); }

  .sugg__arrow{
    position:relative; display:flex; align-items:center; justify-content:center; width:52px; height:56px;
    color:rgba(0,0,0,.42); opacity:0; transform:scale(.5); -webkit-tap-highlight-color:transparent;
  }
  /* the same grey as the dots, whether or not there's anywhere to go */
  .sugg__arrow svg{ position:relative; width:36px; height:36px; fill:currentColor; }
  .sugg__arrow:disabled{ cursor:default; }
  .sugg__aap.is-on .sugg__arrow{ opacity:1; transform:scale(1); transition:opacity .1s ease-in .94s,transform .2s ease-out .94s; }

  .sugg__dot:focus-visible,.sugg__arrow:focus-visible{ outline:2px solid var(--focus,#0071e3); outline-offset:-4px; border-radius:28px; }

  /* bigger phones and tablets: portrait cards like the photos, 400 x 600 */
  @media (min-width:600px) and (max-width:899px){
    .sugg{ --cw:min(calc(87.5vw - 20px),400px); --ch:calc(var(--cw) * 1.5); }
  }
  /* desktop: the cards share the width (up to 400px each) so they all show
     at once; nothing to scroll, so no controls, unless there are too many
     to fit at 260px */
  @media (min-width:900px){
    .sugg{ --pad:max(24px,calc((100vw - 1240px) / 2)); --gap:24px; --img-y:0px; }
    .sugg__card{ flex-basis:max(260px,min(400px,calc((100% - 2 * var(--pad) - (var(--n) - 1) * var(--gap)) / var(--n)))); height:auto; aspect-ratio:2 / 3; }
    .sugg.is-static .sugg__track{ justify-content:center; }
    .sugg.is-static .sugg__gallery{ padding-bottom:0; }
  }
  /* aim assist (see the script): near the gallery, up-and-down drags are
     the script's and sideways swipes stay the browser's */
  html.sugg-aim #main,html.sugg-aim #main *{ touch-action:pan-x; touch-action:pan-x pinch-zoom; }
  @media (prefers-reduced-motion:reduce){
    .sugg__aap,.sugg__aap *,.sugg__aap *::before{ transition:none!important; }
    .sugg__line,.sugg__line.is-up{ transform:none; }   /* the small line fades instead of rolling */
  }
</style>

{%- assign card_count = section.blocks.size -%}
{%- assign card_lines = false -%}
{%- for block in section.blocks -%}{%- if block.settings.line != blank -%}{%- assign card_lines = true -%}{%- endif -%}{%- endfor -%}
{%- assign sub_text = section.settings.subheading -%}
{%- if section.settings.hide_sub -%}{%- assign card_lines = false -%}{%- assign sub_text = '' -%}{%- endif -%}
<section class="sugg{% if section.settings.hide_card_text %} sugg--bare{% endif %}" style="--n:{{ card_count }}" data-sugg data-atc-stop aria-roledescription="carousel"{% if section.settings.heading != blank %} aria-label="{{ section.settings.heading | escape }}"{% endif %}>
  {%- if section.settings.heading != blank or sub_text != blank or card_lines -%}
    <div class="wrap">
      <div class="sugg__head" data-reveal>
        {%- if section.settings.hide_sub and section.settings.heading != blank -%}<div class="sugg__sub sugg__room" aria-hidden="true">&nbsp;</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="sugg__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if card_lines -%}
          {%- comment -%} the subheading (when all the cards show at once), then each card's line {%- endcomment -%}
          <p class="sugg__sub sugg__sub--lines" data-sugg-sub>
            <span class="sugg__line is-up" aria-hidden="true">{{ section.settings.subheading }}</span>
            {%- for block in section.blocks -%}
              <span class="sugg__line{% if forloop.first %} is-on{% endif %}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>{{ block.settings.line | default: section.settings.subheading }}</span>
            {%- endfor -%}
          </p>
        {%- elsif sub_text != blank -%}
          <p class="sugg__sub">{{ sub_text }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="sugg__gallery" data-sugg-gallery>
    <div class="sugg__track" data-sugg-track>
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.link_product -%}
        {%- unless card_product.handle -%}{%- assign card_product = all_products[card_product] -%}{%- endunless -%}
        {%- comment -%} no product chosen: all_products[blank] is an empty product, not nothing {%- endcomment -%}
        {%- if card_product.handle == blank -%}{%- assign card_product = nil -%}{%- endif -%}
        {%- assign card_url = block.settings.link_url -%}
        {%- if card_url == blank and card_product -%}{%- assign card_url = card_product.url -%}{%- endif -%}
        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and card_product -%}{%- assign card_image = card_product.featured_image -%}{%- endif -%}
        {%- assign card_name = card_product.title | default: block.settings.heading -%}
        {%- assign card_title = block.settings.title | default: card_product.title -%}
        {%- assign card_info = false -%}
        {%- if block.settings.label != blank or card_title != blank -%}{%- assign card_info = true -%}{%- endif -%}
        {%- assign card_bar = false -%}
        {%- if card_product or block.settings.desc != blank -%}{%- assign card_bar = true -%}{%- endif -%}
        <div class="sugg__card{% if card_info %} sugg__card--info{% endif %}" data-sugg-card{% if block.settings.img_drop > 0 %} style="--img-drop:{{ block.settings.img_drop }}px"{% endif %} {{ block.shopify_attributes }}>
          {%- if card_image != blank -%}
            <img class="sugg__img" src="{{ card_image | image_url: width: 1000 }}"
                 srcset="{{ card_image | image_url: width: 500 }} 500w, {{ card_image | image_url: width: 750 }} 750w, {{ card_image | image_url: width: 1000 }} 1000w, {{ card_image | image_url: width: 1300 }} 1300w"
                 sizes="(min-width:900px) 400px, calc(87.5vw - 20px)"
                 width="{{ card_image.width }}" height="{{ card_image.height }}"
                 alt="{{ card_image.alt | default: card_name | escape }}" loading="lazy">
          {%- endif -%}
          <div class="sugg__text">
            <h3 class="sugg__card-heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.caption != blank -%}<p class="sugg__card-sub">{{ block.settings.caption }}</p>{%- endif -%}
          </div>
          {%- if card_url != blank -%}
            <a class="sugg__hit" href="{{ card_url }}" aria-label="{{ card_name | default: card_title | escape }}"></a>
          {%- endif -%}
          {%- if card_info or card_bar -%}
            <div class="sugg__foot">
              {%- if card_info -%}
                <div class="sugg__info">
                  {%- if block.settings.label != blank -%}<p class="sugg__label">{{ block.settings.label }}</p>{%- endif -%}
                  {%- if card_title != blank -%}<h3 class="sugg__title">{{ card_title }}</h3>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if card_bar -%}
                <div class="sugg__buy">
                  {%- if block.settings.desc != blank -%}<p class="sugg__desc">{{ block.settings.desc }}</p>{%- endif -%}
                  {%- if card_product -%}
                    <form class="sugg__add" action="{{ routes.cart_add_url }}" method="post" data-quick-add data-error="Try again">
                      <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="sugg__btn sugg__btn--add"{% unless card_product.available %} disabled{% endunless %}>
                        <span data-quick-add-label aria-live="polite">{% if card_product.available %}Add{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                        <span class="visually-hidden">{% if card_product.available %} to bag{% endif %}: {{ card_name | escape }}</span>
                      </button>
                    </form>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if card_count > 1 -%}
      <div class="sugg__aapbox">
        <div class="sugg__aap" data-sugg-aap>
          <span class="sugg__drop" aria-hidden="true"></span>
          <div class="sugg__bubble" data-sugg-bubble>
            <span class="sugg__bg"></span>
            <div class="sugg__dots">
              {%- for block in section.blocks -%}
                <button type="button" class="sugg__dot" data-sugg-dot aria-label="Show {{ forloop.index }} of {{ card_count }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
              {%- endfor -%}
            </div>
          </div>
          <div class="sugg__bubble" data-sugg-bubble>
            <span class="sugg__bg"></span>
            <button type="button" class="sugg__arrow" data-sugg-go="-1" aria-label="Previous" disabled>
              <svg viewBox="0 0 36 36" aria-hidden="true"><path d="m13.44 16.94 5.51-5.5a1.5 1.5 0 0 1 2.12 2.12L16.62 18l4.45 4.44a1.5 1.5 0 0 1-2.12 2.12l-5.51-5.5a1.5 1.5 0 0 1 0-2.12z"/></svg>
            </button>
            <button type="button" class="sugg__arrow" data-sugg-go="1" aria-label="Next">
              <svg viewBox="0 0 36 36" aria-hidden="true"><path d="m22.56 16.94-5.51-5.5a1.5 1.5 0 0 0-2.12 2.12L19.38 18l-4.45 4.44a1.5 1.5 0 0 0 2.12 2.12l5.51-5.5a1.5 1.5 0 0 0 0-2.12z"/></svg>
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  if (window.__sugg) { window.__sugg(); return; }

  /* Apple's spring layer, as its gallery controls use it: one damped spring
     per property (mass 1), stepped at a fixed 60 Hz (semi-implicit Euler)
     and drawn between steps. A spring given a duration and bounce gets
     stiffness (2pi/duration)^2 and damping (1 - bounce) 4pi/duration. */
  const STEP = 1 / 60;
  const active = new Set();
  let cues = [], ticking = false, last = 0, acc = 0;

  function Spring(el, props) {
    this.el = el; this.p = {};
    for (const n in props) {
      const d = props[n];
      let k = d.k, c = d.c;
      if (d.dur) { k = Math.pow(2 * Math.PI / d.dur, 2); c = (1 - (d.bounce || 0)) * 4 * Math.PI / d.dur; }
