<footer class="site-footer">
  <div class="wrap wrap--wide">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <div class="site-header__logo" style="margin-bottom:16px;font-family:Inter,var(--font-body-family,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif) !important;letter-spacing:0 !important;text-transform:none !important;font-weight:700 !important">{{ shop.name | downcase | capitalize }}</div>
        <p class="t-whisper">{{ section.settings.tagline }}</p>
      </div>

      <div>
        <h4>{{ 'footer.shop' | t }}</h4>
        <ul>
          {%- for link in section.settings.menu_shop.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          <li><a href="/pages/calculator">Calculate</a></li>
        </ul>
      </div>

      <div>
        <h4>{{ 'footer.support' | t }}</h4>
        <ul>
          {%- for link in section.settings.menu_support.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4>{{ 'footer.newsletter_heading' | t }}</h4>
        <p style="font-size:.88rem;color:rgba(250,250,248,.55);margin:0 0 16px">{{ section.settings.newsletter_text }}</p>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter">
            <input type="email" name="contact[email]" placeholder="{{ 'footer.email_placeholder' | t }}" required aria-label="{{ 'footer.email_placeholder' | t }}">
            <button type="submit">{{ 'footer.subscribe' | t }}</button>
          </div>
          {% if form.posted_successfully? %}<p style="font-size:.8rem;color:var(--accent);margin-top:10px">{{ 'footer.subscribed' | t }}</p>{% endif %}
        {% endform %}
      </div>
    </div>

    <div class="site-footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</span>
      <ul>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Stay charged, quietly." },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu", "default": "main-menu" },
    { "type": "link_list", "id": "menu_support", "label": "Support menu", "default": "footer" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New colorways and quiet drops. No noise." }
  ]
}
{% endschema %}
