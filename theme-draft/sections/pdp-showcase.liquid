{%- comment -%}
  Apple-style showcase row: small eyebrow, two-line heading (second line in
  an accent colour), a "Shop all" link on the right, then a grid of cards —
  each a soft grey rounded box with an image on top and a bold-lead-in
  caption underneath. Used twice on the Core PDP (accessories, cables) via
  separate instances in templates/product.core.json.
{%- endcomment -%}
<style>
  .pshow{ padding:clamp(48px,7vw,96px) 0; }
  .pshow__head{
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:24px; flex-wrap:wrap; margin:0 0 clamp(24px,3.4vw,36px);
  }
  .pshow__eyebrow{
    font-size:.95rem; color:var(--ink-60); margin:0 0 10px;
  }
  .pshow__heading{
    font-family:var(--sans); font-weight:600; letter-spacing:-0.03em;
    font-size:clamp(1.9rem,3.4vw,2.7rem); line-height:1.1; margin:0;
    color:var(--ink);
  }
  .pshow__heading span{ display:block; color:var(--ink-60); }
  .pshow__link{
    font-size:1rem; color:var(--focus,#0071e3); text-decoration:none;
    white-space:nowrap; padding-bottom:6px;
  }
  .pshow__link:hover{ text-decoration:underline; }

  .pshow__grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:clamp(14px,1.8vw,24px);
  }
  .pshow__card{ display:flex; flex-direction:column; }
  .pshow__media{
    background:#F5F5F7;
    border-radius:clamp(20px,2.2vw,28px);
    aspect-ratio:4/5;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
    margin-bottom:16px;
  }
  .pshow__media img{
    max-width:82%; max-height:82%;
    width:auto; height:auto;
    object-fit:contain;
    display:block;
  }
  .pshow__media--empty{
    color:var(--ink-30,rgba(19,19,22,.28));
    font-size:.85rem;
    text-align:center;
    padding:16px;
  }
  .pshow__caption{
    font-size:.95rem; line-height:1.4; color:var(--ink-60); margin:0;
  }
  .pshow__caption b{ color:var(--ink); font-weight:600; }
</style>

<section class="section pshow">
  <div class="wrap wrap--wide">
    {%- if section.settings.eyebrow != blank or section.settings.heading_main != blank -%}
      <div class="pshow__head" data-reveal>
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="pshow__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading_main != blank -%}
            <h2 class="pshow__heading">{{ section.settings.heading_main }}{%- if section.settings.heading_accent != blank -%}<span>{{ section.settings.heading_accent }}</span>{%- endif -%}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link_url | default: '#' }}" class="pshow__link">{{ section.settings.link_text }} &rsaquo;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pshow__grid">
      {%- for block in section.blocks -%}
        {%- assign _lp = block.settings.link_product -%}
        {%- unless _lp.handle -%}{%- assign _lp = all_products[_lp] -%}{%- endunless -%}
        {%- assign _href = block.settings.link_url -%}
        {%- if _href == blank and _lp -%}{%- assign _href = _lp.url -%}{%- endif -%}
        {%- assign _img = block.settings.image -%}

        <div class="pshow__card" data-reveal {{ block.shopify_attributes }}>
          {%- if _href != blank -%}<a href="{{ _href }}" class="pshow__media"{%- unless _img -%} style="text-decoration:none"{%- endunless -%}>{%- else -%}<div class="pshow__media">{%- endif -%}
            {%- if _img -%}
              <img src="{{ _img | image_url: width: 900 }}"
                   srcset="{{ _img | image_url: width: 500 }} 500w, {{ _img | image_url: width: 900 }} 900w"
                   sizes="(min-width:900px) 30vw, 90vw"
                   alt="{{ _img.alt | default: block.settings.heading | escape }}" loading="lazy">
            {%- else -%}
              <span class="pshow__media--empty">{{ block.settings.heading | default: 'Add image' }}</span>
            {%- endif -%}
          {%- if _href != blank -%}</a>{%- else -%}</div>{%- endif -%}
          <p class="pshow__caption">{%- if block.settings.heading != blank -%}<b>{{ block.settings.heading }}</b> {%- endif -%}{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP showcase row",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Accessories" },
    { "type": "text", "id": "heading_main", "label": "Heading line 1", "default": "All dressed up and" },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (accent colour)", "default": "everywhere to go." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop all accessories" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Bold lead-in", "default": "Bump up the beauty." },
        { "type": "text", "id": "text", "label": "Rest of caption", "default": "Slim and lightweight, designed to match." },
        { "type": "product", "id": "link_product", "label": "Link to product" },
        { "type": "url", "id": "link_url", "label": "Link (overrides product link)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP showcase row",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
