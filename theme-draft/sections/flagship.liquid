{%- assign _ref = section.settings.product -%}
{%- if _ref.handle -%}{%- assign p = _ref -%}{%- else -%}{%- assign p = all_products[_ref] -%}{%- endif -%}
<section class="flagship">
  <div class="wrap wrap--wide">
  <div class="flagship__slab">
  <div class="flagship__grid">
    <div class="flagship__media" data-reveal>
      {%- assign img = section.settings.image | default: p.featured_image -%}
      {%- if img -%}
        <img src="{{ img | image_url: width: 1600 }}"
             srcset="{{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2200 }} 2200w, {{ img | image_url: width: 3000 }} 3000w"
             sizes="(min-width:900px) 46vw, 100vw"
             alt="{{ img.alt | default: p.title | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div data-reveal>
      <span class="t-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="t-xl">{{ section.settings.heading }}</h2>
      <p class="t-body-lg" style="color:rgba(250,250,248,.6);margin-top:16px">{{ section.settings.copy }}</p>

      <div class="flagship__stats">
        {%- for block in section.blocks -%}
          <div class="flagship__stat" {{ block.shopify_attributes }}>
            <span class="t-mono">{{ block.settings.value }}</span>
            <small>{{ block.settings.label }}</small>
          </div>
        {%- endfor -%}
      </div>

      {%- if p -%}
        <a class="btn btn--accent" href="{{ p.url }}">{{ section.settings.cta }} · {{ p.price_min | money }}</a>
      {%- endif -%}
    </div>
  </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Flagship feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The flagship" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Core Pro. The one we reach for." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "A metal shell, a live charge readout, and enough capacity to carry a long day. The rest of the lineup exists so this one doesn't have to leave your bag." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop Core Pro" }
  ],
  "blocks": [
    {
      "type": "stat", "name": "Stat", "limit": 3,
      "settings": [
        { "type": "text", "id": "value", "label": "Value (keep honest — shown in mono)", "default": "10,000 mAh" },
        { "type": "text", "id": "label", "label": "Label", "default": "Capacity" }
      ]
    }
  ],
  "presets": [{
    "name": "Flagship feature",
    "blocks": [
      { "type": "stat", "settings": { "value": "10,000 mAh", "label": "Capacity" } },
      { "type": "stat", "settings": { "value": "Live display", "label": "Charge readout" } },
      { "type": "stat", "settings": { "value": "Metal shell", "label": "Build" } }
    ]
  }]
}
{% endschema %}
